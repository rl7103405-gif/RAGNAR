rules_version = '2';

// Reglas minimas para la prueba de una sola estacion. El perfil (activo) vive
// en usuarios/{uid}. Mientras solo exista la cuenta compartida "estacion",
// cualquier usuario autenticado con perfil activo puede leer/escribir bultos.
service cloud.firestore {
  match /databases/{database}/documents {

    function estaAutenticado() {
      return request.auth != null;
    }

    function perfilActivo() {
      return estaAutenticado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.activo == true;
    }

    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Rol del usuario. SIN default permisivo: un perfil sin 'rol' no es
    // 'completo', es NADA (verificado el 2026-08-12: los 8 perfiles vivos
    // traen su rol, asi que quitar el fallback no bloquea a nadie). Antes
    // caia a 'completo', y con usuarios externos en puerta eso significaba
    // que una maquila con perfil activo operaria como personal interno.
    function rol() {
      return perfilActivo() ? perfil().get('rol', '') : '';
    }

    // A que maquila pertenece este usuario (vacio si no es de una maquila).
    // Se declara aqui arriba porque esInterno() la usa.
    function maquilaDelPerfil() {
      return perfilActivo() ? perfil().get('maquilaId', '') : '';
    }

    // LISTA BLANCA de roles INTERNOS (personal de Quini). Se enumeran a
    // proposito: nunca "rol() != 'maquila'", porque un dedazo en el rol o un
    // campo perdido convertiria a un externo en interno. Lo que no esta aqui
    // no ve la operacion.
    //   captura  -> pesadores (Angel, Juan)
    //   completo -> embarques (America, Diana, Lindbergh, estacion)
    //   consulta -> solo lectura (Cielo)
    //   almacen  -> avios (Alvaro; reservado, aun sin usar)
    //   admin    -> Roberto
    function esInterno() {
      //   produccion -> Adrian, jefe de produccion: sube el PLAN MAESTRO que
      //                 agrupa las ordenes de trabajo bajo su orden de compra.
      //                 No opera embarques, ni avios, ni remisiones.
      //   pt         -> Valeria, Producto Terminado: recibe lo que devuelven las
      //                 maquilas y lleva su inventario. NO paga ni pone precios
      //                 (eso es de Cielo) ni captura folios.
      return rol() in ['captura', 'completo', 'consulta', 'almacen', 'admin', 'produccion', 'pt']
        // Defensa en profundidad: un perfil que trae 'maquilaId' es de una
        // empresa EXTERNA y jamas es interno, aunque su rol diga otra cosa.
        // Sin esto, una cuenta hibrida (rol interno + maquilaId) le abriria a
        // la maquila la operacion completa (pentester, 2026-08-12).
        && maquilaDelPerfil() == '';
    }

    // Quien puede ver LO QUE REPORTARON las maquilas al recibir (faltantes,
    // rechazos, sobrantes). Es mas estrecho que esInterno() a proposito:
    //   captura    -> Angel y Juan solo pesan y capturan folios; un rechazo de
    //                 una maquila no es algo que ellos atiendan.
    //   produccion -> Adrian sube el plan maestro y nada mas.
    // La pantalla ya se los oculta (PanelMaquilasTodo.jsx), pero ocultar un
    // boton no es un permiso: sin esta funcion cualquiera de esos dos roles
    // podria leer los acuses de TODAS las maquilas con el SDK. Mismo patron
    // que puedeVerAvios().
    function puedeVerReportesMaquila() {
      return esInterno() && !(rol() in ['captura', 'produccion']);
    }

    function esAdmin() {
      // esInterno() y no solo el rol: hay ramas que usan esAdmin() DIRECTO
      // (autorizaciones, saldo inicial de inventario, saldos), y sin esto un
      // perfil hibrido admin+maquilaId las cruzaria aunque todas las demas
      // puertas ya lo rechacen. esInterno() no llama esAdmin(): sin recursion.
      return esInterno() && rol() == 'admin';
    }

    // ---- Usuarios EXTERNOS: las maquilas ----
    // ¿Es el usuario de ESTA maquila, y sigue vigente? Se exige que la maquila
    // este activa en el catalogo: dar de baja una maquila (activo=false) cierra
    // su portal de inmediato, con un solo interruptor.
    function esMaquilaDe(mid) {
      return rol() == 'maquila'
        && mid is string
        && mid.size() > 0
        && maquilaDelPerfil() == mid
        && exists(/databases/$(database)/documents/maquilas/$(mid))
        && get(/databases/$(database)/documents/maquilas/$(mid)).data.activo == true
        // La cuenta de maquila de PRUEBA solo entra al portal de una maquila
        // de prueba. Su maquilaId ya la ata a la ficticia, asi que esto es
        // defensa en profundidad: si manana un script le dejara el maquilaId
        // de una maquila real, seguiria sin poder leerle ni escribirle nada.
        // (Se lee el mismo documento que ya se acaba de consultar arriba: no
        // cuesta una lectura mas.)
        && mismoMundoMaquila(mid);
    }

    // Rol 'consulta' (Cielo, 2026-08-12): ve el historial, los reportes, los
    // indicadores y los registros para llevar el control y pasar las
    // remisiones a Microsip, pero NO opera: no captura bultos, no carga
    // Excel, no genera remisiones ni toca el catalogo. Es el primer rol de
    // SOLO LECTURA, asi que cada coleccion que se escribe tiene que
    // excluirlo explicitamente.
    function puedeOperar() {
      // Lista blanca explicita en vez de "todos menos consulta": Alvaro
      // (almacen) tampoco pesa bultos ni corrige capturas, y con el "menos
      // consulta" se le colaba.
      return esInterno() && rol() in ['captura', 'completo', 'admin'];
    }

    // Operaciones de EMBARQUE: cargar el Excel del dia, emitir remisiones,
    // reservar folio interno y mantener el catalogo de maquilas. Es trabajo de
    // embarques (America, Diana, Lindbergh, estacion) y del admin, NO de un
    // pesador: Angel y Juan capturan folios y ya. Detectado modelando los
    // permisos contra los perfiles reales (2026-08-12).
    function puedeEmbarcar() {
      // 'almacen' (Alvaro) NO va aqui: el maneja AVIOS, no remisiones de
      // producto. Incluirlo le daria emitir remisiones y quemar folios
      // internos, que no es su trabajo (mismo error que se cazo con los
      // pesadores el 2026-08-12).
      // esInterno() es obligatorio: sin el, un perfil hibrido (rol completo
      // + maquilaId) emitiria remisiones y quemaria folios internos aunque
      // todas las demas puertas ya lo rechacen (cazado 2026-08-13).
      return esInterno() && rol() in ['completo', 'admin'];
    }

    // Quien puede CREAR/asignar tareas: el admin (Roberto) y quien tenga el
    // flag puedeCrearTareas en su perfil (Lindbergh). America NO: solo recibe.
    function puedeCrearTareas() {
      return esInterno() && (esAdmin() || perfil().get('puedeCrearTareas', false) == true);
    }

    // ===================================================================
    // CUENTAS DE PRUEBA (esPrueba:true) -- el corral
    // ===================================================================
    // RAGNAR no tiene ambiente aislado: no hay proyecto de staging ni prefijo
    // de coleccion. Las cuentas de prueba (web/scripts/crear_usuarios_prueba)
    // entran a la MISMA base que la fabrica, y sus roles son roles de verdad.
    // Lo que las contiene es esto: un corral hecho de condiciones que solo se
    // activan cuando quien escribe es una cuenta de prueba.
    //
    // Regla de oro de este bloque: para un usuario REAL toda condicion de aqui
    // colapsa a `true`. Nada de lo que sigue puede cambiarle el comportamiento
    // a America, Angel, Cielo, Alvaro, Lindbergh ni Roberto -- si alguna vez
    // hay que elegir entre cerrar mas el corral y arriesgar la operacion real,
    // gana la operacion real.
    function esCuentaDePrueba() {
      return perfilActivo() && perfil().get('esPrueba', false) == true;
    }

    // Lo unico que una cuenta de prueba puede capturar. El prefijo va en el ID
    // del documento (el folio), asi que se puede exigir sin leer nada mas, y
    // es lo que despues permite barrer las pruebas sin tocar un bulto real.
    function folioDePrueba(f) {
      return f is string && f.matches('^ZZTEST.*');
    }

    // La maquila ficticia del catalogo. Se consulta el documento y no una
    // lista de ids a mano: si manana hay una segunda maquila de pruebas,
    // basta marcarla y estas reglas la reconocen sin tocarse.
    function maquilaDePrueba(mid) {
      return mid is string
        && mid.size() > 0
        && exists(/databases/$(database)/documents/maquilas/$(mid))
        && get(/databases/$(database)/documents/maquilas/$(mid)).data.get('esPrueba', false) == true;
    }

    // Los tres candados. Se escriben como funciones separadas (y no como un
    // `alcanceOk(condicion)` generico) a proposito: el argumento de una
    // funcion se evalua SIEMPRE, asi que pasarle un get()/exists() dentro
    // gastaria la lectura incluso para los usuarios reales, que son quienes
    // no deberian pagar nada por este bloque.
    function soloCuentaReal() {
      return !esCuentaDePrueba();
    }

    function alcanceFolioOk(folio) {
      return !esCuentaDePrueba() || folioDePrueba(folio);
    }

    // Para las maquilas el candado es SIMETRICO, no unilateral: cada mundo se
    // queda en el suyo. Un `!esCuentaDePrueba() || ...` dejaria que America o
    // Roberto le escribieran al portal de la maquila ficticia (emitirle una
    // remision de verdad, anularle una copia, moverle inventario), y eso
    // ensucia la prueba desde el otro lado -- ademas de que el limpiador
    // borraria despues cosas que un usuario real escribio.
    // Para un usuario real con una maquila real evalua false == false: no le
    // quita ni un flujo legitimo.
    function mismoMundoMaquila(mid) {
      return esCuentaDePrueba() == maquilaDePrueba(mid);
    }

    // Documentos que nacen marcados como de prueba (pdfsGenerados, tareas).
    // Van en las dos direcciones:
    //   - una cuenta de prueba SOLO puede escribirlos con esPrueba:true
    //   - una cuenta real NUNCA puede escribir ese campo
    // La segunda mitad importa tanto como la primera: si un usuario real
    // pudiera marcar un documento como de prueba, el limpiador lo borraria
    // creyendo que es basura.
    function marcaDePruebaCoherente(d) {
      return esCuentaDePrueba()
        ? d.get('esPrueba', false) == true
        : !('esPrueba' in d);
    }

    // Para updates: el documento que ya existe tiene que ser del mismo mundo
    // que quien lo toca. Sin esto, una cuenta de prueba podria cerrar una
    // tarea real o anular una remision real.
    function mismoMundo(datosExistentes) {
      return esCuentaDePrueba() == (datosExistentes.get('esPrueba', false) == true);
    }

    // Cada quien lee su propio perfil. Nadie escribe desde el cliente: las
    // altas se hacen desde web/scripts/ con la llave de servicio --
    // crear_usuario_interno.mjs para la gente de Quini y
    // crear_todas_las_maquilas.mjs para las maquilas.
    match /usuarios/{uid} {
      // Cada quien lee su propio perfil; ademas, CUALQUIER INTERNO lee los
      // demas para elegir destinatario de una tarea y para la pestana "Mi
      // equipo" (2026-08-19). Lo que hay aqui es nombre, rol y si esta activo:
      // no hay datos sensibles — la nomina vive en otra base.
      //
      // Las MAQUILAS (externas, con maquilaId) NO entran: esInterno() las
      // excluye, y no tienen por que ver la plantilla de la fabrica.
      allow read: if request.auth.uid == uid || puedeVerElEquipo();
      allow write: if false;
    }

    // Snapshot de producto congelado en el bulto (Excel del dia + catalogo).
    // Se valida tipo/tamano de cada campo cuando no es null: nunca se confia
    // en que el cliente mande solo lo que cruceProducto.js arma hoy.
    function productoValido(p) {
      // 'ot' va en hasOnly pero NO en hasAll: es la orden de trabajo congelada
      // al capturar (2026-08-17), y los bultos de antes de esa fecha no la
      // traen. Exigirla habria roto la captura con el bundle viejo y obligado
      // a migrar todos los bultos historicos antes de poder tocar ninguno.
      return p.keys().hasAll(['codigo', 'docenas', 'pares', 'total', 'pedido', 'nombreGuia', 'descripcion', 'modelo', 'talla', 'color', 'referencia', 'linea'])
        && p.keys().hasOnly(['codigo', 'docenas', 'pares', 'total', 'pedido', 'nombreGuia', 'descripcion', 'modelo', 'talla', 'color', 'referencia', 'linea', 'ot', 'otOrigen'])
        // Si 'ot' viene, tiene que ser texto NO VACIO: una cadena vacia no es
        // una OT y no deberia poder colarse como si lo fuera.
        && (p.get('ot', null) == null
            || (p.get('ot', '') is string && p.get('ot', '').size() > 0 && p.get('ot', '').size() <= 40))
        // De donde salio la OT. Tres valores y nada mas: dejarlo como texto
        // libre permitiria escribir 'plan' en un bulto cuya OT se adivino del
        // texto, y entonces el campo dejaria de servir justo para lo unico que
        // sirve, que es saber si el agrupado es confiable.
        && (p.get('otOrigen', null) == null
            || p.get('otOrigen', '') in ['plan', 'texto', 'ninguna'])
        // Coherencia: si no hay OT no puede haber origen distinto de 'ninguna'.
        && (p.get('ot', null) != null
            || p.get('otOrigen', 'ninguna') == 'ninguna')
        // Y al reves: si hay OT Y hay otOrigen (con valor), el origen no
        // puede ser 'ninguna' -- ese valor dice "no se encontro OT" y no
        // puede coexistir con una OT presente. Un bundle viejo que trae 'ot'
        // SIN 'otOrigen' sigue pasando: p.get('otOrigen', null) da null
        // cuando el campo no esta, y esa rama del OR ya lo cubre.
        && (p.get('ot', null) == null
            || p.get('otOrigen', null) == null
            || p.get('otOrigen', '') != 'ninguna')
        && (p.codigo == null || (p.codigo is string && p.codigo.size() <= 60))
        && (p.docenas == null || (p.docenas is number && p.docenas >= 0 && p.docenas < 100000000))
        && (p.pares == null || (p.pares is number && p.pares >= 0 && p.pares < 100000000))
        && (p.total == null || (p.total is number && p.total >= 0 && p.total < 100000000))
        && (p.pedido == null || (p.pedido is string && p.pedido.size() <= 100))
        && (p.nombreGuia == null || (p.nombreGuia is string && p.nombreGuia.size() <= 120))
        && (p.descripcion == null || (p.descripcion is string && p.descripcion.size() <= 200))
        && (p.modelo == null || (p.modelo is string && p.modelo.size() <= 200))
        && (p.talla == null || (p.talla is string && p.talla.size() <= 200))
        && (p.color == null || (p.color is string && p.color.size() <= 200))
        && (p.referencia == null || (p.referencia is string && p.referencia.size() <= 200))
        && (p.linea == null || (p.linea is string && p.linea.size() <= 200));
    }

    // Coherencia entre 'cruce' y 'producto'/'catalogoVersion': un bulto
    // 'sin_ruteo' nunca debe traer snapshot de producto, y uno 'completo'
    // siempre debe traer version de catalogo y codigo (igual que arma
    // cruceProducto.js).
    function cruceCoherente(d) {
      return (d.cruce == 'sin_ruteo' && d.producto == null)
        || (d.cruce == 'sin_catalogo' && d.producto is map)
        || (d.cruce == 'completo' && d.producto is map && d.catalogoVersion is string && d.producto.codigo is string);
    }

    // Campos comunes del bulto (captura de folio + peso + snapshot del
    // producto resuelto al pesar). hasAll + hasOnly: ni campos de mas ni de
    // menos. El snapshot producto puede ser null (folio fuera del Excel del
    // dia); si viene, solo admite las llaves conocidas y coherentes con
    // 'cruce'.
    function bultoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['folio', 'pesoGramos', 'operadorUid', 'operadorNombre', 'creadoEn', 'actualizadoEn', 'producto', 'cruce', 'catalogoVersion'])
        && d.keys().hasOnly(['folio', 'pesoGramos', 'operadorUid', 'operadorNombre', 'creadoEn', 'actualizadoEn', 'producto', 'cruce', 'catalogoVersion'])
        && d.folio is string
        && d.folio.size() > 0
        && d.folio.size() <= 50
        && d.folio.matches('^[A-Za-z0-9._-]+$')
        && d.pesoGramos is number
        && d.pesoGramos > 0
        && d.pesoGramos <= 100000
        && d.operadorUid == request.auth.uid
        && d.operadorNombre is string
        && d.operadorNombre.size() <= 120
        && d.actualizadoEn == request.time
        && d.cruce in ['completo', 'sin_ruteo', 'sin_catalogo']
        && (d.catalogoVersion == null || (d.catalogoVersion is string && d.catalogoVersion.size() <= 40))
        && (d.producto == null || (d.producto is map && productoValido(d.producto)))
        && cruceCoherente(d);
    }

    // ¿La reemision que se intenta escribir es la MISMA que Roberto aprobo?
    // Compara maquila y lista de folios contra la propuesta de la solicitud.
    // Las dos listas se ordenan igual en el cliente (compararAscendente), asi
    // que la igualdad de listas es una comparacion valida.
    function solicitudCoincide(datos) {
      let sol = get(/databases/$(database)/documents/solicitudesCorreccion/$(datos.reemision.solicitudId)).data;
      return sol.estado == 'aprobada'
        && sol.folio == datos.reemision.anulaRegistroId
        && sol.tipo == 'editar_pdf'
        && sol.propuesta.maquilaId == datos.maquila.id
        && sol.propuesta.folios == datos.folios;
    }

    // Re-cruce del snapshot de producto: cuando se carga un Excel de ruteo
    // TARDE, los bultos que quedaron 'sin_ruteo' recuperan su codigo. Lo hace
    // quien sube el Excel (America), que NO es quien peso el bulto (Angel o
    // Juan), asi que no puede pasar por bultoValido() -- ese exige
    // operadorUid == auth.uid y falsear el operador seria peor: la tabla
    // diria que America peso el bulto. Se acota igual que marcadoPdfValido:
    // solo los campos del cruce, y nunca sobre un folio ya enviado a PDF.
    function recruceValido() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys()
          .hasOnly(['producto', 'cruce', 'catalogoVersion', 'actualizadoEn'])
        && d.keys().hasAll(['producto', 'cruce', 'catalogoVersion', 'actualizadoEn'])
        && d.actualizadoEn == request.time
        && d.cruce in ['completo', 'sin_ruteo', 'sin_catalogo']
        // Solo se permite MEJORAR: de sin_ruteo/sin_catalogo hacia algo mejor.
        // Nunca borrar un cruce ya resuelto.
        && resource.data.cruce != 'completo'
        && (d.producto == null || (d.producto is map && productoValido(d.producto)))
        && (d.catalogoVersion == null || (d.catalogoVersion is string && d.catalogoVersion.size() <= 40))
        && cruceCoherente(d)
        && resource.data.get('pdfGeneradoEn', null) == null;
    }

    // Liberar el marcador de PDF de un folio que se QUITO de una remision al
    // corregirla (anular y reemitir). Igual que el re-cruce, lo hace quien
    // aplica la correccion, no quien peso: se acota a los campos del marcador
    // y exige la autorizacion 'editar_pdf' de Roberto sobre la remision que se
    // esta anulando (por eso recibe el registroId).
    function desmarcadoPorReemision() {
      return request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['pdfGeneradoEn', 'pdfFolioInterno', 'pdfRegistroId', 'actualizadoEn'])
        // hasAll no sirve aqui: los campos del marcador deben DESAPARECER.
        && !('pdfGeneradoEn' in request.resource.data)
        && !('pdfFolioInterno' in request.resource.data)
        && !('pdfRegistroId' in request.resource.data)
        && request.resource.data.actualizadoEn == request.time
        // La autorizacion se exige sobre EL REGISTRO QUE MARCO A ESTE BULTO
        // (dato del propio marcador previo), no sobre uno cualquiera: con el
        // permiso para corregir la remision A no se pueden liberar los folios
        // de la remision B. Los bultos marcados ANTES de que existiera
        // pdfRegistroId solo los libera el admin.
        && (tieneAutorizacion(resource.data.get('pdfRegistroId', '_ninguno_'), 'editar_pdf')
            || esAdmin());
    }

    // ¿Hay una autorizacion VIGENTE de Roberto para corregir este folio?
    // Las reglas no pueden hacer queries, asi que la autorizacion vive en un
    // documento con ID determinista: autorizaciones/{folio}_{tipo}. La escribe
    // el admin al aprobar la solicitud y se consume (borra) al aplicarla.
    function tieneAutorizacion(folio, tipo) {
      return exists(/databases/$(database)/documents/autorizaciones/$(folio + '_' + tipo));
    }

    // Alcance de las correcciones para una cuenta de prueba. El campo 'folio'
    // de una solicitud/autorizacion no siempre es un folio de bulto: en
    // 'editar_pdf' es el ID del registro de pdfsGenerados que se va a anular.
    // Por eso el criterio cambia con el tipo -- con el prefijo a secas, una
    // correccion de remision de prueba nunca calificaria (los IDs de
    // pdfsGenerados son aleatorios) y una de remision real pasaria de largo.
    function alcanceCorreccionOk(folio, tipo) {
      return !esCuentaDePrueba()
        || (tipo == 'editar_pdf'
              ? (exists(/databases/$(database)/documents/pdfsGenerados/$(folio))
                 && get(/databases/$(database)/documents/pdfsGenerados/$(folio)).data.get('esPrueba', false) == true)
              : folioDePrueba(folio));
    }

    // Autorizaciones puntuales que solo el admin (Roberto) crea. Cualquier
    // usuario activo puede borrar la suya al consumirla: es de un solo uso.
    match /autorizaciones/{autorizacionId} {
      allow read: if esInterno();
      allow create: if perfilActivo() && esAdmin()
        && alcanceCorreccionOk(request.resource.data.folio, request.resource.data.tipo)
        && request.resource.data.keys().hasAll(['folio', 'tipo', 'solicitudId', 'otorgadaPorUid', 'otorgadaPorNombre', 'creadoEn'])
        && request.resource.data.keys().hasOnly(['folio', 'tipo', 'solicitudId', 'otorgadaPorUid', 'otorgadaPorNombre', 'creadoEn'])
        && request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.folio.size() <= 50
        // 'editar_pdf': el "folio" es el ID del registro de pdfsGenerados que
        // se va a anular y reemitir (mismo mecanismo de ID determinista).
        && request.resource.data.tipo in ['editar_peso', 'eliminar', 'editar_pdf']
        && autorizacionId == request.resource.data.folio + '_' + request.resource.data.tipo
        && request.resource.data.solicitudId is string
        && request.resource.data.otorgadaPorUid == request.auth.uid
        && request.resource.data.otorgadaPorNombre is string
        && request.resource.data.otorgadaPorNombre.size() <= 120
        && request.resource.data.creadoEn == request.time;
      allow update: if false;
      // Se borra al consumirla (un solo uso) o si el admin la revoca. Solo
      // puede borrarla el admin o QUIEN LA PIDIO: si cualquiera pudiera,
      // borraria el permiso de un compañero antes de que lo use y este se
      // quedaria bloqueado sin saber por que.
      // Borrar tambien lleva alcance: sin esto una cuenta de prueba podria
      // quemarle a America el permiso que Roberto acababa de darle.
      allow delete: if puedeOperar()
        && alcanceCorreccionOk(resource.data.folio, resource.data.tipo)
        && (esAdmin()
            || (exists(/databases/$(database)/documents/solicitudesCorreccion/$(resource.data.solicitudId))
                && get(/databases/$(database)/documents/solicitudesCorreccion/$(resource.data.solicitudId)).data.pedidoPorUid == request.auth.uid));
    }

    // Marcado "ya salio en un PDF de salida": actualizacion PARCIAL que solo
    // toca los dos campos del marcador (GenerarPdfModal la hace al emitir el
    // PDF). Nota deliberada: las ediciones normales reescriben el documento
    // completo SIN estos campos (tx.set), asi que recapturar o editar el peso
    // borra el marcador y el folio regresa a "pendientes de PDF" -- correcto,
    // porque el PDF viejo ya no coincide con el peso nuevo.
    function marcadoPdfValido() {
      return request.resource.data.diff(resource.data).affectedKeys()
          // pdfRegistroId (opcional) dice QUE registro de pdfsGenerados marco
          // este bulto: sin eso, al corregir una remision no se puede saber si
          // el marcador es de ESA remision o de otra posterior.
          .hasOnly(['pdfGeneradoEn', 'pdfFolioInterno', 'pdfRegistroId'])
        // hasAll explicito: un intento de DESMARCAR (FieldValue.delete())
        // tambien aparece en affectedKeys; se exige que ambos campos existan
        // en el resultado para que quitar el marcador sea imposible.
        && request.resource.data.keys().hasAll(['pdfGeneradoEn', 'pdfFolioInterno'])
        && request.resource.data.pdfGeneradoEn == request.time
        && request.resource.data.pdfFolioInterno is int
        && request.resource.data.pdfFolioInterno > 0
        && request.resource.data.pdfFolioInterno < 1000000000
        && (!('pdfRegistroId' in request.resource.data)
            || (request.resource.data.pdfRegistroId is string
                && request.resource.data.pdfRegistroId.size() <= 128))
        // Un bulto YA marcado por una remision no se puede re-marcar a la
        // ligera (seria "robarle" el folio a otra remision vigente): solo si
        // esta sin marcar, si es el admin, o si hay autorizacion para corregir
        // justo la remision que lo tenia (caso de anular y reemitir).
        && (resource.data.get('pdfGeneradoEn', null) == null
            || esAdmin()
            || tieneAutorizacion(resource.data.get('pdfRegistroId', '_ninguno_'), 'editar_pdf'));
    }

    // Capturas de folio + peso de la estacion unica de prueba. Se valida
    // el contenido para que nadie pueda suplantar operadorUid, falsificar
    // creadoEn, cambiar el folio del documento o vaciar campos.
    match /bultos/{folio} {
      allow read: if esInterno();
      // alcanceFolioOk cubre las tres operaciones y con ellas TODAS las ramas
      // del update (marcado de PDF, re-cruce y desmarcado por reemision): una
      // cuenta de prueba no toca un bulto real por ningun camino, ni siquiera
      // el automatico.
      allow create: if puedeOperar()
        && alcanceFolioOk(folio)
        && bultoValido()
        && request.resource.data.folio == folio
        && request.resource.data.creadoEn == request.time;
      allow update: if puedeOperar()
        && alcanceFolioOk(folio)
        && ((bultoValido()
             && request.resource.data.folio == resource.data.folio
             // creadoEn representa cuando se capturo por primera vez, no la
             // ultima edicion: se preserva el valor original del documento.
             && request.resource.data.creadoEn == resource.data.creadoEn
             // Un folio que YA salio en un PDF no se edita a la ligera: el
             // papel entregado dejaria de coincidir. Solo lo permite un admin
             // (Roberto) o una solicitud de correccion que el aprobo.
             && (resource.data.get('pdfGeneradoEn', null) == null
                 || esAdmin()
                 || tieneAutorizacion(resource.data.folio, 'editar_peso')))
            || marcadoPdfValido()
            || recruceValido()
            // El registro anulado viaja en el campo que se esta limpiando:
            // se toma del propio marcador previo del bulto.
            || desmarcadoPorReemision());
      // Eliminar capturas equivocadas es parte del flujo (menu de la tabla),
      // pero un folio ya enviado a PDF necesita el mismo permiso que editarlo.
      allow delete: if puedeOperar()
        && alcanceFolioOk(folio)
        && (resource.data.get('pdfGeneradoEn', null) == null
            || esAdmin()
            || tieneAutorizacion(resource.data.folio, 'eliminar'));
    }

    // Tareas: metas de produccion por OT o por codigo ("100 docenas de la OT
    // 7887"). Las crea quien tiene rol completo/admin (papa, Lindbergh,
    // America); el avance se calcula en el cliente sumando las capturas que
    // coinciden, y cuando se alcanza la meta se marca 'cumplida'.
    function tareaValida() {
      let d = request.resource.data;
      return d.keys().hasAll(['titulo', 'objetivoTipo', 'objetivoValor', 'metaDocenas', 'estado', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'notas', 'cumplidaEn', 'avanceAlCumplir'])
        && d.keys().hasOnly(['titulo', 'objetivoTipo', 'objetivoValor', 'metaDocenas', 'estado', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'notas', 'cumplidaEn', 'avanceAlCumplir', 'ots', 'asignadoAUid', 'asignadoANombre', 'esPrueba'])
        // Destinatario opcional (a quien se le encarga): uid + nombre. Vacio
        // = sin asignar (la ve quien la creo y el admin).
        && (!('asignadoAUid' in d) || (d.asignadoAUid is string && d.asignadoAUid.size() <= 128))
        && (!('asignadoANombre' in d) || (d.asignadoANombre is string && d.asignadoANombre.size() <= 120))
        // 'ots' es opcional (tareas del Excel especial): lista corta de OTs
        // de 4 digitos para acotar que folios del ruteo cuentan.
        && (!('ots' in d) || (d.ots is list && d.ots.size() <= 30))
        && d.titulo is string
        && d.titulo.size() > 0
        && d.titulo.size() <= 120
        && d.objetivoTipo in ['ot', 'codigo']
        && d.objetivoValor is string
        && d.objetivoValor.size() > 0
        && d.objetivoValor.size() <= 60
        && d.metaDocenas is number
        && d.metaDocenas > 0
        && d.metaDocenas <= 1000000
        && d.estado in ['abierta', 'cumplida', 'cancelada']
        && d.creadoPorNombre is string
        && d.creadoPorNombre.size() <= 120
        && (d.notas == null || (d.notas is string && d.notas.size() <= 300))
        && (d.avanceAlCumplir == null
            || (d.avanceAlCumplir is number && d.avanceAlCumplir >= 0));
    }

    // ¿A quien se le puede encargar esta tarea? Una cuenta de prueba solo se
    // la encarga a otra cuenta de prueba (o a nadie): si no, a una persona
    // real le apareceria en su pantalla una tarea inventada y se pondria a
    // trabajar en ella.
    function destinatarioDelMismoMundo(d) {
      return !esCuentaDePrueba()
        || !('asignadoAUid' in d)
        || d.asignadoAUid == ''
        || (exists(/databases/$(database)/documents/usuarios/$(d.asignadoAUid))
            && get(/databases/$(database)/documents/usuarios/$(d.asignadoAUid)).data.get('esPrueba', false) == true);
    }

    match /tareas/{tareaId} {
      allow read: if esInterno();
      // Los pesadores (rol 'captura') no crean tareas: solo las cumplen.
      allow create: if puedeCrearTareas()
        && marcaDePruebaCoherente(request.resource.data)
        && destinatarioDelMismoMundo(request.resource.data)
        && tareaValida()
        && request.resource.data.estado == 'abierta'
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.creadoEn == request.time
        && request.resource.data.cumplidaEn == null
        && request.resource.data.avanceAlCumplir == null;
      // Cerrar (cumplida/cancelada) o ajustar la meta/notas: cualquier usuario
      // activo con rol distinto de 'captura'. El campo 'cumplidaEn' solo puede
      // ser la hora del servidor, nunca una fecha inventada.
      // Tres ramas con permisos DISTINTOS.
      // mismoMundo envuelve las tres a proposito (y con parentesis propios:
      // sin ellos, `A && B || C` se leeria `(A && B) || C` y la rama de
      // reabrir se quedaria sin candado): una cuenta de prueba no cierra, no
      // reedita y no reabre una tarea real, ni al reves. La marca esPrueba no
      // se puede cambiar despues porque tareaValida() la incluye en el hasOnly
      // pero mismoMundo compara contra el documento que YA existe.
      // mismoMundo mira el documento VIEJO y marcaDePruebaCoherente el NUEVO.
      // Hacen falta los dos: con solo el primero, la rama de reedicion completa
      // (que reescribe el documento entero) dejaba CAMBIAR DE MUNDO -- una
      // cuenta de prueba podia quitarle la marca a su tarea y convertirla en
      // una tarea real, y Lindbergh o Roberto podian marcar como prueba una
      // tarea de verdad, que el limpiador borraria despues sin avisar.
      allow update: if mismoMundo(resource.data)
        && marcaDePruebaCoherente(request.resource.data)
        && destinatarioDelMismoMundo(request.resource.data)
        && ((
          resource.data.estado == 'abierta' && (
            // (1) Quien asigna (Lindbergh/admin): puede reeditar toda la tarea.
            ( puedeCrearTareas()
              && tareaValida()
              && request.resource.data.creadoPorUid == resource.data.creadoPorUid
              && request.resource.data.creadoEn == resource.data.creadoEn
              && (request.resource.data.cumplidaEn == null
                  || request.resource.data.cumplidaEn == resource.data.cumplidaEn
                  || request.resource.data.cumplidaEn == request.time) )
            ||
            // (2) El DESTINATARIO (America) solo puede CERRARLA (cumplir/
            // cancelar): jamas cambiar su meta, objetivo, titulo ni robarsela.
            // El hasOnly ancla que solo esos tres campos pueden moverse.
            ( esInterno()
              && resource.data.asignadoAUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['estado', 'cumplidaEn', 'avanceAlCumplir'])
              && request.resource.data.estado in ['cumplida', 'cancelada']
              && (request.resource.data.cumplidaEn == null
                  || request.resource.data.cumplidaEn == request.time)
              && (request.resource.data.avanceAlCumplir == null
                  || (request.resource.data.avanceAlCumplir is number
                      && request.resource.data.avanceAlCumplir >= 0)) )
          )
        ) || (
          // (3) REABRIR una tarea cerrada: SOLO quien asigna. Es la red de
          // seguridad del cierre automatico (2026-08-13): si una meta
          // estimada corta cerro la tarea antes de tiempo, Lindbergh o el
          // admin la regresan a 'abierta'. Solo se mueven estos tres campos,
          // de vuelta a como estaban al crearla.
          resource.data.estado in ['cumplida', 'cancelada']
          && puedeCrearTareas()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['estado', 'cumplidaEn', 'avanceAlCumplir'])
          && request.resource.data.estado == 'abierta'
          && request.resource.data.cumplidaEn == null
          && request.resource.data.avanceAlCumplir == null
        ));
      allow delete: if false;
    }

    // Bitacora INMUTABLE de cambios sobre capturas: quien edito o elimino
    // que, cuando, con que valores anterior/nuevo y con que motivo. Nadie la
    // edita ni la borra desde el cliente (igual que pdfsGenerados).
    match /cambiosCaptura/{registroId} {
      allow read: if esInterno();
      // El alcance va sobre el folio del CONTENIDO, no del ID (el id es
      // aleatorio). Sin esto, una cuenta de prueba podria inventar renglones
      // de bitacora sobre folios reales sin tocar el bulto: la bitacora es
      // inmutable y esa mentira se quedaria ahi para siempre.
      allow create: if puedeOperar()
        && alcanceFolioOk(request.resource.data.folio)
        && request.resource.data.keys().hasAll(['folio', 'accion', 'antes', 'despues', 'motivo', 'autorizacionId', 'hechoPorUid', 'hechoPorNombre', 'creadoEn'])
        && request.resource.data.keys().hasOnly(['folio', 'accion', 'antes', 'despues', 'motivo', 'autorizacionId', 'hechoPorUid', 'hechoPorNombre', 'creadoEn'])
        && request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        && request.resource.data.folio.size() <= 50
        // 'recruce' = el cruce contra el ruteo se resolvio al cargar un Excel
        // nuevo (automatico, no una correccion humana del peso).
        && request.resource.data.accion in ['editar_peso', 'eliminar', 'recaptura', 'recruce']
        && request.resource.data.antes is map
        && request.resource.data.despues is map
        && (request.resource.data.motivo == null
            || (request.resource.data.motivo is string && request.resource.data.motivo.size() <= 300))
        && (request.resource.data.autorizacionId == null
            || (request.resource.data.autorizacionId is string && request.resource.data.autorizacionId.size() <= 60))
        && request.resource.data.hechoPorUid == request.auth.uid
        && request.resource.data.hechoPorNombre is string
        && request.resource.data.hechoPorNombre.size() <= 120
        && request.resource.data.creadoEn == request.time;
      allow update, delete: if false;
    }

    // Solicitudes de correccion de un folio que YA salio en un PDF: el
    // operador las crea con motivo, y SOLO un admin (Roberto) las aprueba o
    // rechaza. Una solicitud aprobada y sin usar es la llave que permite
    // editar/eliminar ese folio.
    match /solicitudesCorreccion/{solicitudId} {
      allow read: if esInterno();
      allow create: if puedeOperar()
        && alcanceCorreccionOk(request.resource.data.folio, request.resource.data.tipo)
        && request.resource.data.keys().hasAll(['folio', 'tipo', 'motivo', 'estado', 'pedidoPorUid', 'pedidoPorNombre', 'creadoEn', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn', 'usadaEn'])
        && request.resource.data.keys().hasOnly(['folio', 'tipo', 'motivo', 'estado', 'pedidoPorUid', 'pedidoPorNombre', 'creadoEn', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn', 'usadaEn', 'propuesta'])
        && request.resource.data.folio is string
        && request.resource.data.folio.size() > 0
        // 'editar_pdf' guarda el ID del registro de pdfsGenerados (mas largo
        // que un folio de bulto).
        && request.resource.data.folio.size() <= 128
        && request.resource.data.tipo in ['editar_peso', 'eliminar', 'editar_pdf']
        // La PROPUESTA es obligatoria en editar_pdf: Roberto aprueba el cambio
        // CONCRETO (que maquila y que folios), no un permiso abierto para que
        // America decida despues.
        && (request.resource.data.tipo != 'editar_pdf' || (
              'propuesta' in request.resource.data
              && request.resource.data.propuesta is map
              && request.resource.data.propuesta.keys().hasAll(['maquilaId', 'maquilaNombre', 'folios', 'folioInternoOriginal'])
              && request.resource.data.propuesta.keys().hasOnly(['maquilaId', 'maquilaNombre', 'folios', 'folioInternoOriginal'])
              && request.resource.data.propuesta.maquilaId is string
              && request.resource.data.propuesta.maquilaId.size() > 0
              && request.resource.data.propuesta.maquilaNombre is string
              && request.resource.data.propuesta.maquilaNombre.size() > 0
              && request.resource.data.propuesta.maquilaNombre.size() <= 120
              && request.resource.data.propuesta.folios is list
              && request.resource.data.propuesta.folios.size() > 0
              && request.resource.data.propuesta.folios.size() <= 200
              && request.resource.data.propuesta.folioInternoOriginal is int
            ))
        && (request.resource.data.tipo == 'editar_pdf' || !('propuesta' in request.resource.data))
        && request.resource.data.motivo is string
        && request.resource.data.motivo.size() > 0
        && request.resource.data.motivo.size() <= 300
        && request.resource.data.estado == 'pendiente'
        && request.resource.data.pedidoPorUid == request.auth.uid
        && request.resource.data.pedidoPorNombre is string
        && request.resource.data.pedidoPorNombre.size() <= 120
        && request.resource.data.creadoEn == request.time
        && request.resource.data.resueltoPorUid == null
        && request.resource.data.resueltoPorNombre == null
        && request.resource.data.resueltoEn == null
        && request.resource.data.usadaEn == null;
      // Resolver (aprobar/rechazar): SOLO admin, y solo desde 'pendiente'.
      // Con alcance: demo_admin no aprueba una correccion que pidio America.
      allow update: if perfilActivo() && esAdmin()
        && alcanceCorreccionOk(resource.data.folio, resource.data.tipo)
        && resource.data.estado == 'pendiente'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn'])
        && request.resource.data.estado in ['aprobada', 'rechazada']
        && request.resource.data.resueltoPorUid == request.auth.uid
        && request.resource.data.resueltoPorNombre is string
        && request.resource.data.resueltoEn == request.time;
      allow delete: if false;
    }

    // Consumir una solicitud aprobada: quien OPERA puede marcarla como usada
    // al aplicar la correccion (para que no sirva dos veces), pero NUNCA puede
    // cambiar su estado ni quien la aprobo. Un rol de solo consulta no la
    // consume: quemaria el permiso que otra persona esta por usar.
    // OJO: este es el SEGUNDO match de la misma coleccion. Los permisos de
    // dos match que coinciden se combinan con OR, asi que el alcance tiene que
    // repetirse aqui: ponerlo solo arriba dejaria esta puerta abierta.
    match /solicitudesCorreccion/{solicitudId} {
      allow update: if puedeOperar()
        && alcanceCorreccionOk(resource.data.folio, resource.data.tipo)
        && resource.data.estado == 'aprobada'
        && resource.data.usadaEn == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadaEn'])
        && request.resource.data.usadaEn == request.time;
    }

    // Folios esperados del dia, cargados por America desde el Excel
    // ('Folios ruteo', plantilla DATOS PRODUCCION o reporte Seguimiento de
    // Folios). Upsert acumulativo desde el cliente; con el login compartido
    // cualquier sesion activa puede cargar, pero el contenido queda
    // estrictamente validado.
    match /foliosRuteo/{folio} {
      allow read: if esInterno();
      // El ruteo del dia es de TODA la planta y es un upsert acumulativo: no
      // hay "ruteo de prueba" que valga. Una carga hecha desde una cuenta de
      // prueba pisaria los folios buenos y no habria como distinguirla
      // despues, asi que aqui no entran por ningun lado.
      allow create: if puedeEmbarcar() && soloCuentaReal() && ruteoValido(folio);
      // En update, ademas de validar el contenido, se exige que
      // fechaActualizacion nunca retroceda: es la misma defensa que ya
      // implementa cargarRuteo.js del lado del cliente (comparar antes de
      // escribir), pero aqui queda garantizada tambien por el servidor.
      allow update: if puedeEmbarcar() && soloCuentaReal() && ruteoValido(folio) && fechaActualizacionMonotona();
      // La limpieza de retencion (15 dias sin aparecer en ningun Excel) corre
      // desde el cliente, pero la retencion queda garantizada por el
      // SERVIDOR, no solo por el JS de limpiarRuteoViejo(): solo se permite
      // borrar un folio realmente vencido (cargadoEn + 15 dias en el pasado).
      allow delete: if puedeEmbarcar()
        && soloCuentaReal()
        && resource.data.cargadoEn is timestamp
        && request.time > resource.data.cargadoEn + duration.value(15, 'd');
    }

    function ruteoValido(folio) {
      let d = request.resource.data;
      return d.keys().hasAll(['folio', 'codigo', 'docenas', 'pares', 'total', 'pedido', 'nombreGuia', 'descripcion', 'modelo', 'color', 'fecha', 'fechaActualizacion', 'archivoOrigen', 'cargadoEn', 'cargadoPorUid'])
        && d.keys().hasOnly(['folio', 'codigo', 'docenas', 'pares', 'total', 'pedido', 'nombreGuia', 'descripcion', 'modelo', 'color', 'fecha', 'fechaActualizacion', 'archivoOrigen', 'cargadoEn', 'cargadoPorUid'])
        && d.folio == folio
        && d.folio is string
        && d.folio.size() > 0
        && d.folio.size() <= 50
        && d.folio.matches('^[A-Za-z0-9._-]+$')
        && d.codigo is string
        && d.codigo.size() > 0
        && d.codigo.size() <= 60
        && (d.docenas == null || (d.docenas is number && d.docenas >= 0 && d.docenas < 100000000))
        && (d.pares == null || (d.pares is number && d.pares >= 0 && d.pares < 100000000))
        && (d.total == null || (d.total is number && d.total >= 0 && d.total < 100000000))
        // El pedido del reporte Seguimiento de Folios es texto libre (trae
        // ':', 'Ñ', espacios, '/'): solo se acota la longitud, sin patron.
        && (d.pedido == null || (d.pedido is string && d.pedido.size() <= 100))
        && (d.nombreGuia == null || (d.nombreGuia is string && d.nombreGuia.size() <= 120))
        && (d.descripcion == null || (d.descripcion is string && d.descripcion.size() <= 200))
        && (d.modelo == null || (d.modelo is string && d.modelo.size() <= 200))
        && (d.color == null || (d.color is string && d.color.size() <= 200))
        && (d.fecha == null || d.fecha is timestamp)
        && (d.fechaActualizacion == null || d.fechaActualizacion is timestamp)
        && d.archivoOrigen is string
        && d.archivoOrigen.size() <= 120
        && d.cargadoEn == request.time
        && d.cargadoPorUid == request.auth.uid;
    }

    function fechaActualizacionMonotona() {
      return (request.resource.data.fechaActualizacion == null && resource.data.fechaActualizacion == null)
        || (request.resource.data.fechaActualizacion is timestamp
            && (resource.data.fechaActualizacion == null
                || request.resource.data.fechaActualizacion >= resource.data.fechaActualizacion));
    }

    // Catalogo de productos: solo lo escribe el script admin
    // (scripts/cargar_catalogo.mjs); los clientes unicamente leen la
    // version vigente via config/catalogoActual.
    match /catalogoVersiones/{version} {
      allow read: if esInterno();
      allow write: if false;
      match /shards/{shard} {
        allow read: if esInterno();
        allow write: if false;
      }
      // Indice inverso codigo de barras -> codigo de Quini. Mismo alcance que
      // el catalogo: lo escribe solo el script admin, y lo lee quien ya puede
      // leer el catalogo. No es un dato mas sensible que el catalogo mismo,
      // pero tampoco menos: NO se abre a las maquilas.
      match /barras/{shard} {
        allow read: if esInterno();
        allow write: if false;
      }
    }

    // ===================================================================
    // PLAN MAESTRO DE PRODUCCION (Adrian) — el amarre OC -> OT
    // ===================================================================
    // El cliente compra una ORDEN DE COMPRA ('24-49') y la fabrica la parte en
    // 27 o 28 ORDENES DE TRABAJO. La app ya sabe la OT de cada folio (los
    // primeros 4 digitos del pedido), pero no de que OC cuelga: eso lo trae el
    // plan maestro que hoy Adrian lleva en un Excel aparte, y es lo que le
    // falta a Lindbergh para ver su avance agrupado en vez de saberselo de
    // memoria (junta del 2026-08-17).
    //
    // Quien lo sube: SOLO produccion (Adrian) y el admin. Es una capacidad
    // explicita, no algo que se herede por ser interno: quien captura o
    // embarca no tiene por que redibujar el plan de la fabrica.
    // Quien ve la PLANTILLA completa (pestaña "Mi equipo" y elegir
    // destinatario de una tarea): direccion y embarques, nadie mas.
    //
    // ⚠️ Se llego aqui acotando: primero se puso esInterno(), y eso le regalaba
    // el roster con roles y flags de permiso a los pesadores, al almacen, a
    // consulta y a produccion — ninguno de los cuales ve siquiera esa pestaña.
    // Minimo privilegio: la regla se hace tan angosta como el uso real.
    function puedeVerElEquipo() {
      return esInterno() && (esAdmin() || rol() == 'completo');
    }

    function puedeSubirPlanMaestro() {
      return esInterno() && rol() in ['produccion', 'admin'];
    }

    // La subida entera. Nace en 'borrador' y solo se marca 'activa' cuando ya
    // se escribieron todas sus lineas: asi nadie lee un plan a medio cargar.
    match /planMaestroVersiones/{versionId} {
      // Mismo criterio que cargasRuteo: la bitacora de subidas del plan es
      // de la operacion real, y una cuenta de prueba no puede crearla.
      allow read: if esInterno() && soloCuentaReal();
      allow create: if puedeSubirPlanMaestro()
        && soloCuentaReal()
        && request.resource.data.keys().hasAll(['archivo', 'totalLineas', 'estado', 'subidoPorUid', 'subidoPorNombre', 'creadoEn', 'activadaEn'])
        && request.resource.data.keys().hasOnly(['archivo', 'totalLineas', 'totalPedidos', 'estado', 'subidoPorUid', 'subidoPorNombre', 'creadoEn', 'activadaEn'])
        && request.resource.data.estado == 'borrador'
        && request.resource.data.archivo is string
        && request.resource.data.archivo.size() <= 120
        && request.resource.data.totalLineas is int
        && request.resource.data.totalLineas >= 0
        && request.resource.data.totalLineas <= 100000
        && (!('totalPedidos' in request.resource.data)
            || (request.resource.data.totalPedidos is int
                && request.resource.data.totalPedidos >= 0
                && request.resource.data.totalPedidos <= 100000))
        && request.resource.data.subidoPorUid == request.auth.uid
        && request.resource.data.subidoPorNombre == perfil().get('nombreCompleto', '')
        && request.resource.data.creadoEn == request.time
        && request.resource.data.activadaEn == null;
      // Lo unico que se puede cambiar despues es cerrarla (borrador -> activa),
      // y solo quien la subio: una version ajena no se activa por accidente.
      allow update: if puedeSubirPlanMaestro()
        && soloCuentaReal()
        && resource.data.subidoPorUid == request.auth.uid
        && resource.data.estado == 'borrador'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado', 'activadaEn', 'resumen'])
        // El resumen de lo que cambio esta subida (ordenes nuevas, conservadas,
        // ordenes de trabajo que se mudaron de OC). Es la bitacora que se lee
        // despues para dar seguimiento, igual que la de las cargas de folios.
        // Las reglas no pueden mirar dentro de un mapa anidado; lo que si se
        // exige es que sea un mapa y que no crezca sin control.
        && (!('resumen' in request.resource.data) || request.resource.data.resumen is map)
        && request.resource.data.estado == 'activa'
        && request.resource.data.activadaEn == request.time;
      allow delete: if false;
    }

    // Una linea = un renglon planificado (OC + OT + codigo + cantidad).
    // Un documento por linea y NO un array dentro de la OC: las reglas no
    // pueden validar lo que va dentro de una lista, y con array no se podria
    // consultar por OT.
    match /planMaestroLineas/{lineaId} {
      allow read: if esInterno();
      allow create: if puedeSubirPlanMaestro()
        && soloCuentaReal()
        && request.resource.data.keys().hasAll(['versionId', 'oc', 'ot', 'codigo', 'cantidadPlaneada', 'creadoEn', 'subidoPorUid'])
        && request.resource.data.keys().hasOnly(['versionId', 'oc', 'ot', 'codigo', 'cantidadPlaneada', 'unidad', 'cliente', 'descripcion', 'destino', 'hoja', 'creadoEn', 'subidoPorUid'])
        && request.resource.data.versionId is string
        && request.resource.data.versionId.size() > 0
        && request.resource.data.oc is string
        && request.resource.data.oc.size() > 0
        && request.resource.data.oc.size() <= 40
        && request.resource.data.ot is string
        && request.resource.data.ot.size() > 0
        && request.resource.data.ot.size() <= 40
        && request.resource.data.codigo is string
        && request.resource.data.codigo.size() <= 60
        // ⚠️ cantidadPlaneada admite null A PROPOSITO: "no se cuanto" NO es
        // "cero". Una linea sin meta sigue sirviendo (amarra la OT a su OC),
        // solo que no se le puede medir avance — y guardar un 0 ahi la pintaria
        // como "falta 0", o sea como terminada. Cero real y dato ausente tienen
        // que poder distinguirse hasta la pantalla.
        && (request.resource.data.cantidadPlaneada == null
            || (request.resource.data.cantidadPlaneada is number
                && request.resource.data.cantidadPlaneada >= 0
                && request.resource.data.cantidadPlaneada < 100000000))
        && (!('hoja' in request.resource.data)
            || (request.resource.data.hoja is string && request.resource.data.hoja.size() <= 60))
        // A quien va la orden ('Modular Walmart Jun-Sep', 'Shasa RA Agosto'):
        // la vision OT->cliente que pidio la junta del 17-08.
        && (!('destino' in request.resource.data)
            || (request.resource.data.destino is string && request.resource.data.destino.size() <= 120))
        && (!('unidad' in request.resource.data)
            || (request.resource.data.unidad is string && request.resource.data.unidad.size() <= 20))
        && (!('cliente' in request.resource.data)
            || (request.resource.data.cliente is string && request.resource.data.cliente.size() <= 120))
        && (!('descripcion' in request.resource.data)
            || (request.resource.data.descripcion is string && request.resource.data.descripcion.size() <= 200))
        && request.resource.data.creadoEn == request.time
        && request.resource.data.subidoPorUid == request.auth.uid;
      // Una linea del plan no se edita ni se borra: si el plan cambia, se sube
      // una version nueva. Asi lo que se prometio en la semana N sigue siendo
      // consultable en la semana N+1, que es justo lo que hoy no existe.
      allow update, delete: if false;
    }

    // EL DICCIONARIO pedido -> orden de trabajo.
    //
    // Va aparte de las lineas por dos razones. La primera es de costo: esto se
    // consulta AL CAPTURAR un bulto, con el operador esperando en la bascula, y
    // tiene que costar UNA lectura por id determinista — no una consulta que
    // traiga los veinte renglones del mismo pedido. La segunda es de alcance:
    // el diccionario existe aunque la linea no tenga orden de compra, y en el
    // archivo real eso es la mayoria (1214 pedidos conocidos contra 87 ordenes
    // de trabajo amarradas a una OC).
    //
    // Lo que arregla: la OT se venia adivinando de los primeros 4 digitos del
    // texto del pedido, y eso falla en 863 de 3419 renglones del plan real.
    // Los 25 del tipo '7512_REPOSICION_7551' son los graves: contestan 7512,
    // que es una OT que SI existe, y el folio se cuelga de la orden equivocada
    // sin que salte ningun error.
    //
    // Lo lee CUALQUIER interno porque la captura corre en la estacion de
    // pesaje; escribirlo sigue siendo solo de produccion y admin.
    // ORDENES DE COMPRA CERRADAS A MANO. Lo pidio Roberto el 25-08: hay
    // ordenes que en la practica ya quedaron pero no llegan al 100% contra el
    // plan, porque al arrancar la app hubo capturas que no se registraron
    // (la 4504364960: el plan pide 357 docenas y solo 329 pasaron por RAGNAR).
    // Cerrarla a mano es AFIRMAR "esta orden ya quedo, lo que falte no va a
    // llegar": la manda a la seccion de terminadas del Historial.
    //
    // El documento dice QUIEN y CUANDO, siempre: es una afirmacion de negocio,
    // no un dato calculado, y tiene que poder rastrearse. Reabrir = borrarlo.
    // ⚠️ SOLO admin (Roberto, 25-08: "solo mi papa podria cerrar una OC
    // manualmente"). Cerrar es una afirmacion de direccion; embarques,
    // consulta y produccion la VEN cerrada pero no la cierran ni la reabren.
    match /ordenesCompraCerradas/{oc} {
      allow read: if esInterno();
      allow create: if esInterno()
        && rol() == 'admin'
        && request.resource.data.keys().hasAll(['oc', 'cerradaPorUid', 'cerradaPorNombre', 'cerradaEn'])
        && request.resource.data.keys().hasOnly(['oc', 'cerradaPorUid', 'cerradaPorNombre', 'cerradaEn', 'esPrueba'])
        && request.resource.data.oc == oc
        && request.resource.data.oc.size() > 0
        && request.resource.data.oc.size() <= 40
        && request.resource.data.cerradaPorUid == request.auth.uid
        && request.resource.data.cerradaPorNombre == perfil().get('nombreCompleto', '')
        && request.resource.data.cerradaEn == request.time
        && marcaDePruebaCoherente(request.resource.data);
      // No se edita: se reabre (delete) y se vuelve a cerrar si hace falta,
      // para que el QUIEN/CUANDO siempre sea del ultimo cierre real.
      allow update: if false;
      allow delete: if esInterno() && rol() == 'admin'
        // Cada mundo reabre lo suyo: una cuenta de prueba no puede borrar el
        // cierre que hizo un usuario real, ni al reves.
        && (esCuentaDePrueba() == (resource.data.get('esPrueba', false) == true));
    }

    match /planMaestroPedidos/{pedidoId} {
      allow read: if esInterno();
      allow create: if puedeSubirPlanMaestro()
        && soloCuentaReal()
        && request.resource.data.keys().hasAll(['versionId', 'pedidoClave', 'ot', 'creadoEn', 'subidoPorUid'])
        && request.resource.data.keys().hasOnly(['versionId', 'pedidoClave', 'pedidoTexto', 'ot', 'destino', 'creadoEn', 'subidoPorUid'])
        && request.resource.data.versionId is string
        && request.resource.data.versionId.size() > 0
        && request.resource.data.pedidoClave is string
        && request.resource.data.pedidoClave.size() > 0
        && request.resource.data.pedidoClave.size() <= 200
        && (!('pedidoTexto' in request.resource.data)
            || (request.resource.data.pedidoTexto is string
                && request.resource.data.pedidoTexto.size() <= 200))
        && (!('destino' in request.resource.data)
            || (request.resource.data.destino is string
                && request.resource.data.destino.size() <= 120))
        && request.resource.data.ot is string
        && request.resource.data.ot.size() > 0
        && request.resource.data.ot.size() <= 40
        && request.resource.data.creadoEn == request.time
        && request.resource.data.subidoPorUid == request.auth.uid;
      // Igual que las lineas: una entrada no se corrige en caliente. Si el
      // plan cambia se sube otra version, y lo ya capturado conserva la OT que
      // se le resolvio en su momento.
      allow update, delete: if false;
    }

    // El puntero a la version vigente. Se mueve al terminar de subir.
    match /config/planMaestroActivo {
      allow read: if esInterno();
      allow write: if puedeSubirPlanMaestro()
        && soloCuentaReal()
        && request.resource.data.keys().hasAll(['versionId', 'activadaEn', 'activadaPorUid'])
        && request.resource.data.keys().hasOnly(['versionId', 'archivo', 'totalLineas', 'totalPedidos', 'ocs', 'activadaEn', 'activadaPorUid', 'activadaPorNombre'])
        && request.resource.data.versionId is string
        && request.resource.data.versionId.size() > 0
        && (!('archivo' in request.resource.data)
            || (request.resource.data.archivo is string && request.resource.data.archivo.size() <= 120))
        && (!('totalLineas' in request.resource.data)
            || (request.resource.data.totalLineas is int && request.resource.data.totalLineas >= 0))
        && (!('totalPedidos' in request.resource.data)
            || (request.resource.data.totalPedidos is int && request.resource.data.totalPedidos >= 0))
        // El resumen por orden de compra viaja aqui para que abrir la pestana
        // cueste UNA lectura en vez de las 3419 lineas del plan. Las reglas no
        // pueden mirar dentro de una lista, asi que lo unico que se puede
        // exigir es que sea lista y que no crezca sin control: un documento de
        // Firestore tiene tope de 1 MB y pasarse tumbaria la subida entera.
        && (!('ocs' in request.resource.data)
            || (request.resource.data.ocs is list && request.resource.data.ocs.size() <= 500))
        // Anclado al perfil, igual que subidoPorNombre en planMaestroVersiones:
        // el cliente siempre manda el nombre de quien esta activando, asi que
        // nada legitimo se rompe con exigir que coincida con el perfil.
        && (!('activadaPorNombre' in request.resource.data)
            || (request.resource.data.activadaPorNombre is string
                && request.resource.data.activadaPorNombre.size() <= 120
                && request.resource.data.activadaPorNombre == perfil().get('nombreCompleto', '')))
        && request.resource.data.activadaEn == request.time
        && request.resource.data.activadaPorUid == request.auth.uid;
    }

    // Estado del ruteo (maximo folio visto + marca de la ultima limpieza):
    // lo escribe el cliente al terminar cada carga de Excel. Validado campo
    // por campo; actualizadoEn siempre es la hora del servidor (tambien se
    // usa como referencia de "ahora" para la retencion de 15 dias, sin
    // confiar en el reloj de la PC).
    // Contenido valido para config/ruteoEstado, comun a create y update.
    function ruteoEstadoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['maxFolioNumero', 'actualizadoEn', 'ultimaLimpieza'])
        && d.keys().hasOnly(['maxFolioNumero', 'actualizadoEn', 'ultimaLimpieza'])
        && (d.maxFolioNumero == null
            || (d.maxFolioNumero is int
                && d.maxFolioNumero >= 0
                && d.maxFolioNumero < 1000000000000000))
        && d.actualizadoEn == request.time
        && (d.ultimaLimpieza == null || d.ultimaLimpieza is timestamp);
    }

    match /config/ruteoEstado {
      allow read: if esInterno();
      // Va con foliosRuteo: es el estado global de esa misma carga.
      allow create: if puedeEmbarcar() && soloCuentaReal() && ruteoEstadoValido();
      // En update, ademas del contenido valido, se exige que el maximo
      // nunca retroceda (monotonia, igual que fechaActualizacionMonotona en
      // foliosRuteo) y que ultimaLimpieza o se conserve tal cual o sea
      // exactamente "ahora": nunca un timestamp arbitrario/futuro inventado
      // por el cliente.
      allow update: if puedeEmbarcar() && soloCuentaReal() && ruteoEstadoValido()
        && (resource.data.maxFolioNumero == null
            || (request.resource.data.maxFolioNumero is number
                && request.resource.data.maxFolioNumero >= resource.data.maxFolioNumero))
        // NOTA (pentest 2026-08-31): se evaluo topar el salto de maxFolioNumero
        // para que un insider no lo ponga al techo y mate el analisis de
        // huecos, PERO un "cambio de serie" legitimo (SALTO_ANORMAL en
        // web/src/utils/ruteoEstado.js) SI salta mucho y la app lo permite
        // explicitamente; un tope rompia ese flujo en silencio. Se deja sin
        // tope: el analisis de huecos es una salvaguarda secundaria y el actor
        // es interno de confianza. Cierre real (si se decide) = mover el avance
        // del maximo a una Cloud Function, no un candado de reglas.
        && (request.resource.data.ultimaLimpieza == null
            || request.resource.data.ultimaLimpieza == resource.data.ultimaLimpieza
            || request.resource.data.ultimaLimpieza == request.time);
      allow delete: if false;
    }

    // Consecutivo del folio interno de las salidas. Solo avanza: el numero
    // nuevo nunca puede ser menor que el ya registrado (asi dos personas
    // generando a la vez no reciclan un folio ya impreso).
    function folioInternoValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['ultimo', 'actualizadoEn'])
        && d.keys().hasOnly(['ultimo', 'actualizadoEn'])
        && d.ultimo is int
        && d.ultimo > 0
        && d.ultimo < 1000000000
        && d.actualizadoEn == request.time;
    }

    match /config/folioInternoEstado {
      allow read: if esInterno();
      // Reservar un folio interno es una operacion de EMISION: quien solo
      // consulta (Cielo) no puede quemar el consecutivo oficial. Avanzarlo es
      // irreversible (nunca retrocede), asi que un numero gastado por error
      // queda como salto permanente en la numeracion del papel.
      //
      // Este es el consecutivo OFICIAL, el que lleva el papa de Roberto en
      // papel. Las cuentas de prueba tienen el suyo (folioInternoPrueba, aqui
      // abajo) justamente para que probar una remision no le abra un hueco en
      // su numeracion. El candado esta aqui y no solo en la app: si el cliente
      // pasara el contador equivocado, el servidor lo rechaza.
      allow create: if puedeEmbarcar() && soloCuentaReal() && folioInternoValido();
      allow update: if puedeEmbarcar()
        && soloCuentaReal()
        && folioInternoValido()
        && request.resource.data.ultimo >= resource.data.ultimo
        // Tope de salto: la emision legitima avanza +1 (folioInterno.js) y una
        // resincronizacion manual con el papel salta pocas decenas. Sin este
        // tope, un insider de embarque (o una tablet compartida) podia poner
        // `ultimo` al techo (1e9-1) y bloquear IRREVERSIBLEMENTE la emision de
        // remisiones de toda la fabrica (pentest 2026-08-20). Un salto mayor a
        // 1000 se hace por script con service account, no desde la app.
        && request.resource.data.ultimo <= resource.data.ultimo + 1000;
      allow delete: if false;
    }

    // Consecutivo PARALELO de las cuentas de prueba. Mismo contenido y misma
    // monotonia que el oficial (para que la prueba se parezca a lo real), pero
    // en otro documento: lo que se queme aqui no le mueve un numero al papel
    // de la fabrica. Solo lo tocan las cuentas de prueba; una cuenta real que
    // llegara aqui por un bug de la app seria rechazada.
    match /config/folioInternoPrueba {
      allow read: if esInterno();
      allow create: if puedeEmbarcar() && esCuentaDePrueba() && folioInternoValido();
      allow update: if puedeEmbarcar()
        && esCuentaDePrueba()
        && folioInternoValido()
        && request.resource.data.ultimo >= resource.data.ultimo
        // Mismo tope de salto que el consecutivo oficial (ver arriba).
        && request.resource.data.ultimo <= resource.data.ultimo + 1000;
      allow delete: if false;
    }

    match /config/{documento} {
      allow read: if esInterno();
      allow write: if false;
    }

    // Bitacora INMUTABLE de PDFs de salida generados: quien lo genero (texto
    // declarativo, el login es compartido), maquila, folios y el contenido
    // congelado para reimpresion fiel. Nunca se edita ni borra desde cliente.
    // Nota: las reglas no pueden validar cada elemento de un array; el
    // contenido de 'capturas' se valida solo en forma (lista del mismo
    // tamano que folios).
    match /pdfsGenerados/{registroId} {
      allow read: if esInterno();
      allow create: if puedeEmbarcar()
        // Una cuenta de prueba solo puede emitir a la maquila ficticia, y el
        // registro nace con esPrueba:true (una cuenta real NO puede escribir
        // ese campo: si pudiera, el limpiador borraria una remision de verdad
        // creyendola basura).
        //
        // ⚠️ LIMITE CONOCIDO: las reglas no pueden recorrer una lista, asi que
        // no hay forma de exigir aqui que TODOS los folios del array sean
        // ZZTEST. Si una cuenta de prueba mete folios reales en su remision de
        // prueba, el registro se crea -- pero el marcado "ya salio en PDF" de
        // esos bultos se rechaza uno por uno (alcanceFolioOk en /bultos), asi
        // que ningun bulto real queda tocado: solo queda un registro de prueba
        // con folios que menciona y que el limpiador se lleva.
        && mismoMundoMaquila(request.resource.data.maquila.id)
        && marcaDePruebaCoherente(request.resource.data)
        && request.resource.data.keys().hasAll(['generadoPor', 'maquila', 'folios', 'totalFolios', 'pesoTotalGramos', 'capturas', 'encabezado', 'fechaTexto', 'creadoEn', 'operadorUid'])
        && request.resource.data.keys().hasOnly(['generadoPor', 'maquila', 'folios', 'totalFolios', 'pesoTotalGramos', 'capturas', 'encabezado', 'fechaTexto', 'creadoEn', 'operadorUid', 'reemision', 'esPrueba'])
        // REEMISION (correccion autorizada): este registro anula y sustituye a
        // otro. Solo se acepta con una autorizacion 'editar_pdf' vigente del
        // admin sobre el registro que se anula, para que nadie pueda inventar
        // una remision "corregida" sin permiso de Roberto.
        && (!('reemision' in request.resource.data) || (
              request.resource.data.reemision is map
              && request.resource.data.reemision.keys().hasAll(['anulaRegistroId', 'anulaFolioInterno', 'revision', 'motivo', 'solicitudId'])
              && request.resource.data.reemision.keys().hasOnly(['anulaRegistroId', 'anulaFolioInterno', 'revision', 'motivo', 'solicitudId'])
              && request.resource.data.reemision.anulaRegistroId is string
              && request.resource.data.reemision.anulaRegistroId.size() > 0
              && request.resource.data.reemision.anulaFolioInterno is int
              && request.resource.data.reemision.revision is int
              && request.resource.data.reemision.revision >= 2
              && request.resource.data.reemision.revision <= 20
              && request.resource.data.reemision.motivo is string
              && request.resource.data.reemision.motivo.size() > 0
              && request.resource.data.reemision.motivo.size() <= 300
              && request.resource.data.reemision.solicitudId is string
              && request.resource.data.reemision.solicitudId.size() > 0
              && tieneAutorizacion(request.resource.data.reemision.anulaRegistroId, 'editar_pdf')
              // La autorizacion no basta: lo que se emite tiene que ser
              // EXACTAMENTE lo que Roberto aprobo. Sin este cruce, tener el
              // permiso equivaldria a poder reemitir a cualquier maquila con
              // cualquier lista de folios (la garantia viviria solo en la
              // pantalla, que es inspeccionable).
              && solicitudCoincide(request.resource.data)
            ))
        && request.resource.data.generadoPor is string
        && request.resource.data.generadoPor.size() > 0
        && request.resource.data.generadoPor.size() <= 80
        && request.resource.data.maquila is map
        && request.resource.data.maquila.keys().hasOnly(['id', 'nombre'])
        && request.resource.data.maquila.id is string
        && request.resource.data.maquila.id.size() > 0
        && request.resource.data.maquila.nombre is string
        && request.resource.data.maquila.nombre.size() > 0
        && request.resource.data.folios is list
        && request.resource.data.folios.size() > 0
        && request.resource.data.folios.size() <= 200
        && request.resource.data.totalFolios == request.resource.data.folios.size()
        && request.resource.data.pesoTotalGramos is number
        && request.resource.data.pesoTotalGramos >= 0
        && request.resource.data.pesoTotalGramos <= 100000 * request.resource.data.folios.size()
        && request.resource.data.capturas is list
        && request.resource.data.capturas.size() == request.resource.data.folios.size()
        && request.resource.data.encabezado is map
        && request.resource.data.fechaTexto is string
        && request.resource.data.fechaTexto.size() > 0
        && request.resource.data.fechaTexto.size() <= 20
        && request.resource.data.creadoEn == request.time
        && request.resource.data.operadorUid == request.auth.uid;
      // El SNAPSHOT es inmutable (folios, capturas, encabezado, maquila: nunca
      // se tocan). Lo unico que se puede escribir despues es el MARCADOR de
      // anulacion, y solo con la autorizacion de Roberto sobre este registro:
      // asi el registro viejo declara por si mismo que fue sustituido, sin que
      // ninguna vista tenga que ir a buscar sucesores.
      allow update: if puedeEmbarcar()
        // Anular una remision (para reemitirla) solo dentro del propio mundo:
        // una cuenta de prueba no anula un papel real, y una cuenta real no
        // anula uno de prueba.
        && mismoMundo(resource.data)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anuladaPorRegistroId', 'anuladaEn', 'anuladaFolioInterno'])
        && request.resource.data.keys().hasAll(['anuladaPorRegistroId', 'anuladaEn', 'anuladaFolioInterno'])
        && resource.data.get('anuladaPorRegistroId', null) == null
        && request.resource.data.anuladaPorRegistroId is string
        && request.resource.data.anuladaPorRegistroId.size() > 0
        && request.resource.data.anuladaFolioInterno is int
        && request.resource.data.anuladaFolioInterno > 0
        && request.resource.data.anuladaEn == request.time
        // El sucesor tiene que existir Y declarar que anula a ESTE registro:
        // asi no se puede dejar una remision "ANULADA" sin reemplazo real.
        // Se usa getAfter (no exists/get): el sucesor se CREA en el mismo
        // writeBatch, asi que con get() no existiria todavia y la regla
        // rechazaria el flujo legitimo. getAfter evalua el estado ya aplicado.
        && getAfter(/databases/$(database)/documents/pdfsGenerados/$(request.resource.data.anuladaPorRegistroId))
             .data.reemision.anulaRegistroId == registroId
        && tieneAutorizacion(registroId, 'editar_pdf');
      allow delete: if false;
    }

    // Bitacora INMUTABLE de subidas del Excel de folios: que archivo entro,
    // cuando, quien lo subio y que trajo. Nunca se edita ni se borra desde
    // el cliente (igual que pdfsGenerados).
    // RECEPCION EN PRODUCTO TERMINADO (2026-08-28).
    //
    // El acta de lo que PT conto cuando llego la mercancia de la maquila.
    // Roberto: "la principal funcion de Valeria es recibir esto... que si
    // ahorita le llega algo, que lo registre".
    //
    // La ESCRIBE PRODUCTO TERMINADO (rol 'pt') y direccion. Cielo NO: ella
    // lleva los pagos, no recibe mercancia -- Roberto, 2026-08-28: "Cielo no
    // recibe, ella hace los pagos, no es el mismo perfil".
    //
    // Es INMUTABLE: se crea y no se edita ni se borra. Es un acta con nombre y
    // hora de quien conto; si algo salio mal se levanta otra y se explica en la
    // nota. Reescribir el pasado seria justamente lo que hace inservible un
    // acta a la hora de una aclaracion con la maquila.
    // EL PL (packing list): lo que SALE al cliente. Acta INMUTABLE por entrega,
    // igual que la recepcion: se levanta, no se reescribe. El papel se arma
    // juntando las actas de la misma orden de compra.
    match /entregasPL/{entregaId} {
      // Mas estrecho que esInterno(): el PL trae PRECIO DE VENTA al cliente e
      // importes. Un pesador y Adrian no participan del embarque y no tienen
      // por que ver lo que se le cobra a un cliente. Mismo criterio que
      // puedeVerReportesMaquila().
      allow read: if esInterno() && !(rol() in ['captura', 'produccion']);
      // Quien embarca al cliente es Producto Terminado. Cielo NO: ella lleva
      // los pagos a maquilas, no la salida al cliente.
      allow create: if esInterno()
        && rol() in ['pt', 'admin']
        && entregaPlValida()
        // EL CANDADO CONTRA REGISTRAR DOS VECES LA MISMA ENTREGA. El ID lo
        // amarra al contenido: OC + numero (+ el corral de prueba). Como
        // 'create' solo aplica cuando el documento NO existe y 'update' esta
        // prohibido, el segundo intento de la entrega 2 de la misma OC lo
        // rechaza el servidor aunque el cliente tenga un bug o alguien de
        // doble clic. Sin esto, dos actas de la misma entrega se sumaban en
        // los totales del PL y el papel salia con mas packs y mas dinero de
        // los que de verdad se entregaron.
        && entregaId == request.resource.data.oc + '__' + string(request.resource.data.numeroEntrega)
             + (esCuentaDePrueba() ? '__prueba' : '');
      allow update, delete: if false;
    }

    function entregaPlValida() {
      let d = request.resource.data;
      return d.keys().hasAll(['oc', 'po', 'pl', 'subcliente', 'numeroEntrega', 'factura', 'bitacora', 'pedidoMicrosip', 'remisionMicrosip', 'fechaEntregaTexto', 'renglones', 'totalBultos', 'totalPacks', 'totalPiezas', 'totalImporte', 'nota', 'creadoEn', 'creadoPorUid', 'creadoPorNombre', 'esPrueba'])
        && d.keys().hasOnly(['oc', 'po', 'pl', 'subcliente', 'numeroEntrega', 'factura', 'bitacora', 'pedidoMicrosip', 'remisionMicrosip', 'fechaEntregaTexto', 'renglones', 'totalBultos', 'totalPacks', 'totalPiezas', 'totalImporte', 'nota', 'creadoEn', 'creadoPorUid', 'creadoPorNombre', 'esPrueba'])
        && d.oc is string && d.oc.size() > 0 && d.oc.size() <= 40
        && d.po is string && d.po.size() <= 40
        && d.pl is string && d.pl.size() <= 40
        && d.subcliente is string && d.subcliente.size() <= 120
        // El papel trae hasta SEIS bloques de entrega. Mas que eso es un
        // dedazo, no una entrega.
        && d.numeroEntrega is int && d.numeroEntrega >= 1 && d.numeroEntrega <= 6
        // De Microsip y del portal del cliente: pueden ir VACIOS, y vacio es
        // la respuesta correcta cuando no se tienen. Nunca un cero.
        && d.factura is string && d.factura.size() <= 40
        && d.bitacora is string && d.bitacora.size() <= 40
        && d.pedidoMicrosip is string && d.pedidoMicrosip.size() <= 40
        && d.remisionMicrosip is string && d.remisionMicrosip.size() <= 40
        && d.fechaEntregaTexto is string && d.fechaEntregaTexto.size() <= 40
        && d.renglones is list
        && d.renglones.size() > 0
        && d.renglones.size() <= 300
        && d.totalBultos is int && d.totalBultos >= 0
        && d.totalPacks is int && d.totalPacks >= 0
        && d.totalPiezas is int && d.totalPiezas >= 0
        && d.totalImporte is number && d.totalImporte >= 0
        && d.nota is string && d.nota.size() <= 300
        && d.creadoEn == request.time
        && d.creadoPorUid == request.auth.uid
        && d.creadoPorNombre == perfil().get('nombreCompleto', '')
        // El corral de las cuentas de prueba: una demo no ensucia el PL real.
        && d.esPrueba == esCuentaDePrueba();
    }

    match /recepcionesPT/{recepcionId} {
      allow read: if esInterno();
      allow create: if esInterno()
        && rol() in ['pt', 'admin']
        && recepcionValida();
      allow update, delete: if false;
    }

    function recepcionValida() {
      let d = request.resource.data;
      return d.keys().hasAll(['origenTipo', 'documentoId', 'folioInterno', 'maquilaId', 'maquilaNombre', 'fechaSalidaTexto', 'renglones', 'cuadro', 'renglonesConProblema', 'nota', 'recibidoEn', 'recibidoPorUid', 'recibidoPorNombre', 'esPrueba'])
        && d.keys().hasOnly(['origenTipo', 'documentoId', 'folioInterno', 'maquilaId', 'maquilaNombre', 'fechaSalidaTexto', 'renglones', 'cuadro', 'renglonesConProblema', 'nota', 'recibidoEn', 'recibidoPorUid', 'recibidoPorNombre', 'esPrueba'])
        // De donde sale la referencia contra la que se conto. Hoy solo existe
        // 'salida' (el documento con el que se le mando la mercancia a la
        // maquila). Se acota desde ahora para que el dia que se agregue el
        // origen 'maquila' sea una decision y no un descuido.
        && d.origenTipo == 'salida'
        && d.documentoId is string
        && d.documentoId.size() > 0
        && d.documentoId.size() <= 60
        && d.folioInterno is string
        && d.folioInterno.size() <= 40
        && d.maquilaId is string
        && d.maquilaId.size() > 0
        && d.maquilaId.size() <= 60
        // El corral, en las dos direcciones: una cuenta de prueba solo levanta
        // actas de la maquila ficticia, y una real nunca de la de prueba.
        && mismoMundoMaquila(d.maquilaId)
        && d.maquilaNombre is string
        && d.maquilaNombre.size() <= 120
        && d.fechaSalidaTexto is string
        && d.fechaSalidaTexto.size() <= 40
        && d.renglones is list
        && d.renglones.size() > 0
        && d.renglones.size() <= 300
        && d.cuadro is bool
        && d.renglonesConProblema is int
        && d.renglonesConProblema >= 0
        && d.nota is string
        && d.nota.size() <= 300
        && d.recibidoEn == request.time
        // Nadie levanta un acta a nombre de otro: el acta vale por quien firma.
        && d.recibidoPorUid == request.auth.uid
        && d.recibidoPorNombre is string
        && d.recibidoPorNombre.size() > 0
        && d.recibidoPorNombre.size() <= 120
        && d.esPrueba is bool
        && d.esPrueba == esCuentaDePrueba();
    }

    match /cargasRuteo/{registroId} {
      // Una cuenta de prueba NO ve las cargas reales. Es la contraparte de
      // que no pueda crearlas: si no puede escribir aqui, todo lo que hay es
      // del mundo real y no tiene por que verlo -- el 28-08 Roberto abrio el
      // ensayo con la cuenta demo y le aparecieron las subidas de America,
      // con nombres y volumenes de la operacion.
      allow read: if esInterno() && soloCuentaReal();
      // Va con foliosRuteo: si una cuenta de prueba no puede cargar el Excel,
      // tampoco puede escribir la bitacora de esa carga.
      allow create: if puedeEmbarcar()
        && soloCuentaReal()
        && request.resource.data.keys().hasAll(['archivo', 'esquema', 'totalFolios', 'nuevos', 'actualizados', 'sinCambios', 'enriquecidos', 'omitidos', 'errores', 'completa', 'subioNombre', 'subioUid', 'creadoEn'])
        && request.resource.data.keys().hasOnly(['archivo', 'esquema', 'totalFolios', 'nuevos', 'actualizados', 'sinCambios', 'enriquecidos', 'omitidos', 'errores', 'completa', 'subioNombre', 'subioUid', 'creadoEn'])
        && request.resource.data.completa == false
        && request.resource.data.archivo is string
        && request.resource.data.archivo.size() <= 120
        && request.resource.data.esquema is string
        && request.resource.data.esquema.size() <= 40
        && request.resource.data.totalFolios is int
        && request.resource.data.totalFolios >= 0
        && request.resource.data.totalFolios <= 50000
        && request.resource.data.nuevos is int
        && request.resource.data.actualizados is int
        && request.resource.data.sinCambios is int
        && request.resource.data.enriquecidos is int
        && request.resource.data.omitidos is int
        && request.resource.data.errores is int
        && request.resource.data.subioNombre is string
        && request.resource.data.subioNombre.size() <= 120
        && request.resource.data.subioUid == request.auth.uid
        && request.resource.data.creadoEn == request.time;
      // Unico update permitido: CERRAR el registro con el resultado real al
      // terminar la carga (quien la inicio, una sola vez). Lo demas del
      // registro -- archivo, quien, cuando -- queda inmutable.
      allow update: if puedeEmbarcar()
        && soloCuentaReal()
        && resource.data.subioUid == request.auth.uid
        && resource.data.completa == false
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['nuevos', 'actualizados', 'sinCambios', 'enriquecidos', 'omitidos', 'errores', 'completa'])
        && request.resource.data.completa == true
        && request.resource.data.nuevos is int
        && request.resource.data.actualizados is int
        && request.resource.data.sinCambios is int
        && request.resource.data.enriquecidos is int
        && request.resource.data.omitidos is int
        && request.resource.data.errores is int;
      allow delete: if false;
    }

    // ===================================================================
    // AVIOS: el material que Alvaro (almacen) manda a las maquilas para
    // que puedan ensamblar. Plastiflechas (varios tipos), etiquetas,
    // cajas, cinta canela. Cada uno es un codigo propio con su unidad.
    // ===================================================================

    // Quien manda material y maneja el inventario/solicitudes de avios:
    // Alvaro (rol 'almacen') y el admin. No es trabajo de embarques ni de
    // captura. OJO: el CATALOGO ya no es de el (ver abajo).
    // Quien pone y edita los PRECIOS que se le pagan a cada maquila.
    // Solo Cielo (consulta) y direccion (admin) — decision de Roberto el
    // 2026-08-24. Es dinero: en la junta del 17-08 se conto que un error de
    // tarifa costo ~50,000 pesos en una semana, asi que ni Lindbergh, que
    // encarga las tareas, ni el almacen los tocan.
    //
    // esInterno() y no solo el rol: un perfil hibrido (rol interno +
    // maquilaId) editaria los precios de TODAS las maquilas.
    function puedeEditarPrecios() {
      return esInterno() && rol() in ['consulta', 'admin'];
    }

    function precioEnsambleValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['modelo', 'maquilaId', 'precioPorPack', 'actualizadoEn', 'actualizadoPorUid', 'actualizadoPorNombre'])
        && d.keys().hasOnly(['modelo', 'maquilaId', 'precioPorPack', 'actualizadoEn', 'actualizadoPorUid', 'actualizadoPorNombre', 'descripcion', 'notas', 'creadoEn', 'codigoBarras'])
        && d.modelo is string && d.modelo.size() > 0 && d.modelo.size() <= 60
        // El precio es un NUMERO y tiene tope: un cero por error deja sin
        // pagar, y un tecleo de mas (1000 en vez de 10.00) infla la remision.
        && d.precioPorPack is number
        && d.precioPorPack > 0
        && d.precioPorPack <= 10000
        && d.actualizadoEn == request.time
        && d.actualizadoPorUid == request.auth.uid
        && d.actualizadoPorNombre == perfil().get('nombreCompleto', '')
        && (!('descripcion' in d) || (d.descripcion is string && d.descripcion.size() <= 200))
        && (!('notas' in d) || (d.notas is string && d.notas.size() <= 200))
        // Con que codigo de barras se encontro este producto. Se guarda para
        // poder rastrear de donde salio el precio cuando el archivo de pagos
        // de la maquila trae barras y la remision trae codigo de Quini.
        && (!('codigoBarras' in d) || (d.codigoBarras is string && d.codigoBarras.size() >= 8 && d.codigoBarras.size() <= 30));
    }

    // VER no es MANEJAR. Alvaro (almacen) y direccion mueven el material;
    // Cielo y Producto Terminado necesitan MIRARLO para dar seguimiento sin
    // preguntarle a nadie -- Roberto, 2026-08-28: "dale a PT todo lo de las
    // maquilas, todo, que vea todo".
    //
    // Se separa en dos funciones a proposito, en vez de ensanchar
    // puedeManejarAvios(): esa se usa tambien en reglas de ESCRITURA, y
    // agregarle 'consulta' ahi le daria a Cielo y a Valeria la capacidad de
    // mover inventario de una maquila. La lectura es lo unico que se abre.
    function puedeVerAvios() {
      // Lindbergh entra por puedeCrearTareas() y no por su rol: 'completo' lo
      // comparte con America y Diana, que no tienen por que ver el material de
      // las maquilas. Roberto, 2026-08-28: "todo lo de las maquilas lo deberia
      // poder ver Lindbergh, todo".
      return esInterno()
        && (rol() in ['almacen', 'admin', 'consulta', 'pt'] || puedeCrearTareas());
    }

    function puedeManejarAvios() {
      // esInterno() y no solo el rol: un perfil hibrido (rol interno +
      // maquilaId) manejaria los envios de TODAS las maquilas.
      return esInterno() && rol() in ['almacen', 'admin'];
    }

    // Quien administra el CATALOGO de avios: Cielo, via el flag
    // administraCatalogoAvios de su perfil, y el admin. Decision de Roberto
    // (2026-08-13): Alvaro manda material, pero las claves del catalogo las
    // controla Cielo. Mismo patron que puedeCrearTareas.
    function puedeAdministrarCatalogoAvios() {
      return esInterno()
        && (esAdmin() || perfil().get('administraCatalogoAvios', false) == true);
    }

    function avioValido() {
      let d = request.resource.data;
      return d.keys().hasAll(['codigo', 'descripcion', 'tipo', 'unidad', 'activo', 'creadoEn', 'creadoPorUid'])
        && d.keys().hasOnly(['codigo', 'descripcion', 'tipo', 'unidad', 'activo', 'creadoEn', 'creadoPorUid', 'actualizadoEn', 'actualizadoPorUid', 'actualizadoPorNombre', 'claveMicrosip'])
        && d.codigo is string
        && d.codigo.size() > 0
        && d.codigo.size() <= 60
        && d.descripcion is string
        && d.descripcion.size() > 0
        && d.descripcion.size() <= 200
        && d.tipo in ['plastiflecha', 'etiqueta', 'caja', 'cinta', 'bolsa', 'otro']
        // 'kg' entro con el catalogo real de Microsip (bolsas a granel). El
        // inventario cuenta ENTEROS (kg completos): las cantidades con
        // decimales se rechazan en el cliente con mensaje claro, porque los
        // movimientos y saldos de abajo exigen int.
        && d.unidad in ['piezas', 'rollos', 'millares', 'metros', 'cajas', 'kg']
        && d.activo is bool
        // La clave EXACTA de Microsip cuando difiere del codigo normalizado
        // (los SRFID llevan espacio y el ID no). Para exportar a Microsip, la
        // fuente canonica es claveMicrosip si existe; si no, el codigo.
        && (!('claveMicrosip' in d) || (d.claveMicrosip is string && d.claveMicrosip.size() > 0 && d.claveMicrosip.size() <= 60));
    }

    // El catalogo lo leen TODOS los internos (America y Lindbergh necesitan
    // ver que material existe) y tambien las maquilas: sin conocer los codigos
    // no podrian pedir lo que les falta. No revela nada del negocio de otras
    // maquilas: es una lista de materiales, no de movimientos.
    match /avios/{avioId} {
      allow read: if esInterno() || rol() == 'maquila';
      // El catalogo de avios son las 158 claves reales de Microsip, y los
      // inventarios de las maquilas cuelgan de ellas: no hay "avio de prueba"
      // que no ensucie el catalogo de verdad. Las cuentas de prueba lo leen,
      // no lo escriben.
      allow create: if puedeAdministrarCatalogoAvios()
        && soloCuentaReal()
        && avioValido()
        && request.resource.data.codigo == avioId
        && request.resource.data.creadoEn == request.time
        && request.resource.data.creadoPorUid == request.auth.uid;
      // Se puede corregir la descripcion o dar de baja; el codigo (que es el
      // ID), la claveMicrosip y el tipo/unidad no se cambian: ya hay
      // movimientos de inventario contados en esa unidad. Toda edicion queda
      // firmada (quien y cuando): el catalogo cambio de dueno y conviene el
      // rastro.
      allow update: if puedeAdministrarCatalogoAvios()
        && soloCuentaReal()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['descripcion', 'activo', 'actualizadoEn', 'actualizadoPorUid', 'actualizadoPorNombre'])
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() > 0
        && request.resource.data.descripcion.size() <= 200
        && request.resource.data.activo is bool
        && request.resource.data.actualizadoEn == request.time
        && request.resource.data.actualizadoPorUid == request.auth.uid
        && request.resource.data.actualizadoPorNombre == perfil().get('nombreCompleto', '')
        && request.resource.data.actualizadoPorNombre.size() > 0;
      allow delete: if false;
    }

    // ===================================================================
    // PORTAL DE LA MAQUILA (usuarios EXTERNOS)
    // ===================================================================

    // Copia MINIMA de la remision que se le manda a la maquila. Solo lo que
    // ella necesita para verificar lo que recibio: nada de pedidos completos,
    // guias, catalogo ni datos de otras maquilas.
    function salidaPortalValida(mid) {
      let d = request.resource.data;
      return d.keys().hasAll(['registroId', 'maquilaId', 'folioInterno', 'fechaTexto', 'ots', 'folios', 'renglones', 'totalFolios', 'totalDocenas', 'pesoTotalGramos', 'creadoEn', 'emitidaPorNombre'])
        && d.keys().hasOnly(['registroId', 'maquilaId', 'folioInterno', 'fechaTexto', 'ots', 'folios', 'renglones', 'totalFolios', 'totalDocenas', 'pesoTotalGramos', 'creadoEn', 'emitidaPorNombre', 'anuladaPorRegistroId', 'anuladaEn'])
        // 'folios' es el array PLANO: lo usa la regla del acuse para verificar
        // que la maquila no reclame faltantes que nunca estuvieron.
        && d.folios is list
        && d.folios.size() == d.renglones.size()
        && d.maquilaId == mid
        && d.registroId is string
        && d.registroId.size() > 0
        && d.folioInterno is int
        && d.folioInterno > 0
        && d.fechaTexto is string
        && d.fechaTexto.size() <= 20
        && d.ots is list
        && d.ots.size() <= 60
        && d.renglones is list
        && d.renglones.size() > 0
        && d.renglones.size() <= 200
        && d.totalFolios is int
        && d.totalFolios == d.renglones.size()
        && d.totalDocenas is number
        && d.totalDocenas >= 0
        && d.pesoTotalGramos is number
        && d.pesoTotalGramos >= 0
        && d.emitidaPorNombre is string
        && d.emitidaPorNombre.size() <= 80
        && d.creadoEn == request.time;
    }

    // Acuse de la maquila: declara que recibio, y si hay diferencia la AVISA
    // (no rechaza). Solo cantidades y folios; jamas precios ni pesos nuevos.
    function acuseValido(mid, registroId) {
      let d = request.resource.data;
      let sal = get(/databases/$(database)/documents/portalMaquila/$(mid)/salidas/$(registroId)).data;
      return d.keys().hasAll(['registroId', 'maquilaId', 'resultado', 'foliosFaltantes', 'foliosSobrantes', 'comentario', 'recibidoPorUid', 'recibidoPorNombre', 'creadoEn'])
        && d.keys().hasOnly(['registroId', 'maquilaId', 'resultado', 'foliosFaltantes', 'foliosSobrantes', 'foliosRechazados', 'pesados', 'comentario', 'recibidoPorUid', 'recibidoPorNombre', 'creadoEn'])
        // La maquila PESA lo que recibe: 'pesados' guarda el peso que ella
        // midio folio por folio, y 'foliosRechazados' los que no cuadraron.
        // Los rechazados tienen que ser folios que si iban en la remision.
        && (!('pesados' in d) || (d.pesados is list && d.pesados.size() <= 200))
        && (!('foliosRechazados' in d) || (
              d.foliosRechazados is list
              && d.foliosRechazados.size() <= 200
              && (!('folios' in sal) || sal.folios.hasAll(d.foliosRechazados))
            ))
        && d.maquilaId == mid
        && d.registroId is string
        && d.registroId.size() > 0
        && d.resultado in ['completo', 'con_diferencias']
        && d.foliosFaltantes is list
        && d.foliosSobrantes is list
        && d.comentario is string
        && d.comentario.size() <= 300
        // COHERENCIA ESTRICTA en las dos direcciones. Antes un 'completo'
        // podia traer faltantes: la UI los escondia y quedaba una declaracion
        // tramposa por escrito, exhibible despues como "yo si lo reporte".
        && (d.resultado != 'completo'
            || (d.foliosFaltantes.size() == 0
                && d.foliosSobrantes.size() == 0
                && d.get('foliosRechazados', []).size() == 0
                && d.comentario.size() == 0))
        && (d.resultado != 'con_diferencias'
            || d.foliosFaltantes.size() > 0
            || d.foliosSobrantes.size() > 0
            || d.get('foliosRechazados', []).size() > 0
            || d.comentario.size() > 0)
        // Los FALTANTES tienen que ser folios que de verdad iban en SU
        // remision: si no, podria reclamar bultos que nunca se le mandaron.
        // (Los SOBRANTES no se validan a proposito: un folio que llego
        // duplicado es un sobrante legitimo.)
        && d.foliosFaltantes.size() <= sal.totalFolios
        && d.foliosSobrantes.size() <= 200
        && (!('folios' in sal) || sal.folios.hasAll(d.foliosFaltantes))
        && d.recibidoPorUid == request.auth.uid
        // El nombre lo fija el PERFIL, no el cliente: antes podia firmar como
        // "America (Quini)" y la declaracion es inmutable.
        && d.recibidoPorNombre == perfil().get('nombreCompleto', '')
        && d.creadoEn == request.time;
    }

    // Lo que la maquila ve de una remision. Lo escribe Quini al emitir el PDF
    // (mismo lote que la bitacora) y es INMUTABLE: es la copia de un papel ya
    // emitido.
    match /portalMaquila/{maquilaId}/salidas/{registroId} {
      allow read: if esInterno() || esMaquilaDe(maquilaId);
      allow create: if puedeEmbarcar()
        && mismoMundoMaquila(maquilaId)
        && salidaPortalValida(maquilaId)
        && request.resource.data.registroId == registroId
        // La copia tiene que corresponder a un registro REAL de la bitacora y
        // a ESA maquila. getAfter (no get) porque los dos documentos se crean
        // en el mismo writeBatch. Sin esto, cualquiera con permiso de embarque
        // podia inyectar una remision fantasma -- o volcar la de otra maquila
        // -- en el portal, y es irreversible (update/delete estan cerrados).
        && getAfter(/databases/$(database)/documents/pdfsGenerados/$(registroId)).data.maquila.id == maquilaId
        && getAfter(/databases/$(database)/documents/pdfsGenerados/$(registroId)).data.folios.size()
             == request.resource.data.totalFolios;
      // El SNAPSHOT es inmutable. Lo unico que se puede escribir despues es el
      // marcador de anulacion, cuando la remision se corrige y se reemite: si
      // no, la maquila seguiria viendo como vigente un papel ya anulado.
      allow update: if puedeEmbarcar()
        && mismoMundoMaquila(maquilaId)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['anuladaPorRegistroId', 'anuladaEn'])
        && request.resource.data.keys().hasAll(['anuladaPorRegistroId', 'anuladaEn'])
        && resource.data.get('anuladaPorRegistroId', null) == null
        && request.resource.data.anuladaPorRegistroId is string
        && request.resource.data.anuladaPorRegistroId.size() > 0
        && request.resource.data.anuladaEn == request.time
        && tieneAutorizacion(registroId, 'editar_pdf');
      allow delete: if false;
    }

    // Lo que la maquila PIDE cuando le falta material para ensamblar.
    function solicitudAvioValida(mid) {
      let d = request.resource.data;
      return d.keys().hasAll(['maquilaId', 'maquilaNombre', 'renglones', 'nota', 'estado', 'pedidoPorUid', 'pedidoPorNombre', 'creadoEn'])
        && d.keys().hasOnly(['maquilaId', 'maquilaNombre', 'renglones', 'nota', 'estado', 'pedidoPorUid', 'pedidoPorNombre', 'creadoEn', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn', 'respuesta'])
        && d.maquilaId == mid
        && d.maquilaNombre is string
        && d.maquilaNombre.size() > 0
        && d.maquilaNombre.size() <= 120
        && d.renglones is list
        && d.renglones.size() > 0
        // Tope sano: una solicitud es "me falta esto", no un pedido anual.
        && d.renglones.size() <= 40
        && d.nota is string
        && d.nota.size() <= 300
        && d.estado == 'pendiente'
        && d.pedidoPorUid == request.auth.uid
        // El nombre lo fija el perfil, igual que en el acuse: no se firma
        // a nombre de otro.
        && d.pedidoPorNombre == perfil().get('nombreCompleto', '')
        && d.creadoEn == request.time
        // No puede nacer ya respondida: la maquila se auto-marcaria "atendida"
        // con una respuesta inventada de almacen.
        && !('resueltoPorUid' in d)
        && !('resueltoPorNombre' in d)
        && !('resueltoEn' in d)
        && !('respuesta' in d);
    }

    match /portalMaquila/{maquilaId}/solicitudesAvios/{solicitudId} {
      allow read: if puedeVerAvios() || esMaquilaDe(maquilaId);
      allow create: if esMaquilaDe(maquilaId) && solicitudAvioValida(maquilaId);
      // La maquila puede CANCELAR su propia solicitud mientras nadie la haya
      // atendido (se equivoco al pedir). SOLO Alvaro/admin la resuelven: los
      // pedidos de material son de almacen, no de embarques ni de quien
      // asigna tareas (recorte de Roberto, 2026-08-13).
      allow update: if mismoMundoMaquila(maquilaId) && resource.data.estado == 'pendiente' && (
          ( esMaquilaDe(maquilaId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
            && request.resource.data.estado == 'cancelada' )
          ||
          ( puedeManejarAvios()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn', 'respuesta'])
            && request.resource.data.estado in ['atendida', 'rechazada']
            && request.resource.data.resueltoPorUid == request.auth.uid
            // El nombre lo fija el perfil (mismo criterio que el acuse): nadie
            // resuelve firmando como otra persona.
            && request.resource.data.resueltoPorNombre == perfil().get('nombreCompleto', '')
            && request.resource.data.resueltoEn == request.time
            && (!('respuesta' in request.resource.data)
                || (request.resource.data.respuesta is string
                    && request.resource.data.respuesta.size() <= 300)) )
        );
      allow delete: if false;
    }

    // Un envio de material de Alvaro a una maquila.
    function envioAvioValido(mid) {
      let d = request.resource.data;
      return d.keys().hasAll(['maquilaId', 'maquilaNombre', 'renglones', 'nota', 'enviadoPorUid', 'enviadoPorNombre', 'creadoEn'])
        && d.keys().hasOnly(['maquilaId', 'maquilaNombre', 'renglones', 'nota', 'enviadoPorUid', 'enviadoPorNombre', 'creadoEn', 'solicitudId'])
        && d.maquilaId == mid
        && d.maquilaNombre is string
        && d.maquilaNombre.size() > 0
        && d.maquilaNombre.size() <= 120
        && d.renglones is list
        && d.renglones.size() > 0
        && d.renglones.size() <= 60
        && d.nota is string
        && d.nota.size() <= 300
        && d.enviadoPorUid == request.auth.uid
        && d.enviadoPorNombre == perfil().get('nombreCompleto', '')
        && d.creadoEn == request.time
        && (!('solicitudId' in d)
            || (d.solicitudId is string && d.solicitudId.size() <= 128));
    }

    // Acuse de la maquila sobre un envio de material. Declara cuanto llego DE
    // VERDAD de cada codigo: es la base del inventario y de las disputas
    // ("yo si te lo mande"). Se firma una vez y no se edita.
    function acuseAvioValido(mid, envioId) {
      let d = request.resource.data;
      let env = get(/databases/$(database)/documents/portalMaquila/$(mid)/enviosAvios/$(envioId)).data;
      return d.keys().hasAll(['envioId', 'maquilaId', 'resultado', 'recibido', 'comentario', 'recibidoPorUid', 'recibidoPorNombre', 'creadoEn'])
        && d.keys().hasOnly(['envioId', 'maquilaId', 'resultado', 'recibido', 'comentario', 'recibidoPorUid', 'recibidoPorNombre', 'creadoEn'])
        && d.envioId == envioId
        && d.maquilaId == mid
        && d.resultado in ['completo', 'con_diferencias']
        // 'recibido' es la lista de lo que llego de verdad, un renglon por
        // codigo del envio: mismo tamano, sin inventar codigos.
        && d.recibido is list
        && d.recibido.size() == env.renglones.size()
        && d.comentario is string
        && d.comentario.size() <= 300
        // Coherencia en las dos direcciones, igual que el acuse de remisiones:
        // 'completo' no admite comentario de diferencias.
        && (d.resultado != 'completo' || d.comentario.size() == 0)
        && d.recibidoPorUid == request.auth.uid
        && d.recibidoPorNombre == perfil().get('nombreCompleto', '')
        && d.creadoEn == request.time;
    }

    // Lectura de envios/acuses de avios: SOLO almacen/admin del lado interno
    // (America y Lindbergh ya no ven avios: recorte de Roberto 2026-08-13).
    match /portalMaquila/{maquilaId}/enviosAvios/{envioId} {
      allow read: if puedeVerAvios() || esMaquilaDe(maquilaId);
      // mismoMundoMaquila: demo_almacen manda material solo a la maquila
      // ficticia. Los saldos de avios son una cadena encadenada (saldo antes /
      // saldo despues), asi que un envio de prueba a una maquila real no se
      // podria deshacer sin romperla.
      allow create: if puedeManejarAvios() && mismoMundoMaquila(maquilaId) && envioAvioValido(maquilaId);
      allow update, delete: if false;
    }

    match /portalMaquila/{maquilaId}/acusesAvios/{envioId} {
      allow read: if puedeManejarAvios() || esMaquilaDe(maquilaId);
      allow create: if esMaquilaDe(maquilaId)
        && request.resource.data.envioId == envioId
        && exists(/databases/$(database)/documents/portalMaquila/$(maquilaId)/enviosAvios/$(envioId))
        && acuseAvioValido(maquilaId, envioId);
      allow update, delete: if false;
    }

    // --- INVENTARIO: libro de movimientos (inmutable) y saldo (espejo) ---

    function movimientoAvioValido(mid) {
      let d = request.resource.data;
      return d.keys().hasAll(['maquilaId', 'codigo', 'descripcion', 'unidad', 'tipo', 'cantidad', 'saldoAntes', 'saldoDespues', 'origenTipo', 'motivo', 'hechoPorUid', 'hechoPorNombre', 'creadoEn'])
        && d.keys().hasOnly(['maquilaId', 'codigo', 'descripcion', 'unidad', 'tipo', 'cantidad', 'saldoAntes', 'saldoDespues', 'origenTipo', 'origenId', 'motivo', 'hechoPorUid', 'hechoPorNombre', 'creadoEn'])
        && d.maquilaId == mid
        && d.codigo is string
        && d.codigo.size() > 0
        && d.codigo.size() <= 60
        && d.descripcion is string
        && d.descripcion.size() <= 200
        && d.unidad is string
        && d.unidad.size() <= 20
        && d.tipo in ['entrada_envio', 'ajuste_conteo', 'ajuste_maquila', 'saldo_inicial', 'devolucion', 'consumo_ensamble']
        // ENTEROS y la cadena grabada: saldoDespues == saldoAntes + cantidad.
        // Con decimales esta igualdad fallaria de forma intermitente.
        && d.cantidad is int
        && d.cantidad != 0
        && d.saldoAntes is int
        && d.saldoAntes >= 0
        && d.saldoDespues is int
        && d.saldoDespues >= 0
        && d.saldoDespues == d.saldoAntes + d.cantidad
        && d.origenTipo in ['envio', 'conteo', 'arranque', 'devolucion', 'ensamble']
        && (!('origenId' in d) || (d.origenId is string && d.origenId.size() <= 128))
        && d.motivo is string
        && d.motivo.size() <= 300
        && d.hechoPorUid == request.auth.uid
        && d.hechoPorNombre == perfil().get('nombreCompleto', '')
        && d.creadoEn == request.time;
    }

    match /portalMaquila/{maquilaId}/movimientosAvios/{movId} {
      allow read: if puedeVerAvios() || esMaquilaDe(maquilaId);
      allow create: if mismoMundoMaquila(maquilaId) && movimientoAvioValido(maquilaId) && (
          // ENTRADA por un envio: la escribe la MAQUILA al acusar, con la
          // cantidad que declara haber recibido (decision de Roberto: gana lo
          // que dice la maquila). El ID determinista 'env_{envioId}_{codigo}'
          // hace imposible aplicar dos veces el mismo envio.
          ( request.resource.data.tipo == 'entrada_envio'
            && esMaquilaDe(maquilaId)
            && request.resource.data.cantidad > 0
            && request.resource.data.origenTipo == 'envio'
            && 'origenId' in request.resource.data
            && movId == 'env_' + request.resource.data.origenId + '_' + request.resource.data.codigo
            // El acuse se crea en el MISMO lote: getAfter, no get.
            && getAfter(/databases/$(database)/documents/portalMaquila/$(maquilaId)/acusesAvios/$(request.resource.data.origenId)).data.maquilaId == maquilaId )
          ||
          // AJUSTE por conteo fisico y DEVOLUCION: los captura almacen, con
          // motivo obligatorio de verdad (no un espacio).
          ( request.resource.data.tipo in ['ajuste_conteo', 'devolucion']
            && puedeManejarAvios()
            && request.resource.data.motivo.size() >= 10 )
          ||
          // AJUSTE DE LA MAQUILA: ella corrige lo que de verdad tiene en su
          // bodega (Roberto, 2026-09-01: "que ellos puedan actualizar
          // inventario o editarlo").
          //
          // Va con TIPO PROPIO, no como 'ajuste_conteo', a proposito: un
          // conteo de Alvaro y una correccion de la maquila no valen lo mismo
          // ni las firma el mismo, y en el libro tienen que distinguirse. Si
          // compartieran tipo, dentro de un mes nadie podria decir quien
          // movio ese saldo ni con que autoridad.
          //
          // El motivo largo es el precio de poder tocar el saldo: sin el, un
          // ajuste es un numero que aparecio de la nada.
          ( request.resource.data.tipo == 'ajuste_maquila'
            && esMaquilaDe(maquilaId)
            && request.resource.data.origenTipo == 'conteo'
            && request.resource.data.motivo.size() >= 10
            // El motivo tiene que traer PALABRAS: diez espacios cumplian el
            // tamano y no explican nada. CEL no tiene trim(), asi que se pide
            // que haya al menos una palabra de cuatro letras.
            && request.resource.data.motivo.matches('.*[A-Za-z]{4}.*')
            // ID con prefijo PROPIO. Sin esto, la maquila podia crear su
            // ajuste con el id reservado de otro flujo ('ini_{codigo}' o
            // 'env_{envioId}_{codigo}') y, como el libro no se edita ni se
            // borra, quemarlo PARA SIEMPRE: el admin ya no podria sentar el
            // saldo inicial de ese material, y un envio real se quedaria sin
            // poder acusarse. No es escalada, es sabotaje irreversible.
            && movId.matches('^ajm_.*')
            // El SALDO se escribe en el MISMO lote y apunta a este movimiento.
            // Sin esta linea el movimiento podia ir SOLO, con 'saldoAntes' y
            // 'saldoDespues' inventados (basta que sumen), y el libro dejaba
            // de ser verificable: se podia fabricar evidencia firmada de un
            // inventario que nunca existio, y sin forma de borrarla. El saldo
            // ya exige su movimiento (saldoAtadoAlMovimiento); esto cierra la
            // simetria que faltaba.
            && getAfter(/databases/$(database)/documents/portalMaquila/$(maquilaId)/saldosAvios/$(request.resource.data.codigo)).data.ultimoMovimientoId == movId
            // El material tiene que existir en el catalogo: si no, aparecen
            // renglones inventados en el inventario que revisa Alvaro.
            && exists(/databases/$(database)/documents/avios/$(request.resource.data.codigo))
            // Tope de cordura. No frena el abuso de a poquito (nada en las
            // reglas puede), pero convierte "999 millones de un golpe" en mil
            // movimientos que se ven en el panel. El cliente ya pregunta por
            // los cambios grandes, pero el cliente no es una frontera.
            && request.resource.data.cantidad > -100000
            && request.resource.data.cantidad < 100000
            && request.resource.data.saldoDespues <= 1000000 )
          ||
          // SALDO INICIAL: solo el admin. Es el arranque del inventario y el
          // punto mas fragil de todo: un saldo "a ojo" contamina todo lo que
          // se construya encima.
          ( request.resource.data.tipo == 'saldo_inicial'
            && esAdmin()
            && request.resource.data.cantidad > 0
            && request.resource.data.saldoAntes == 0
            && movId == 'ini_' + request.resource.data.codigo )
        );
      allow update, delete: if false;
    }

    // El SALDO nunca se escribe solo: siempre en el mismo lote que el
    // movimiento que lo explica, y encadenado con el saldo anterior.
    function saldoAtadoAlMovimiento(mid, codigo) {
      let d = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/portalMaquila/$(mid)/movimientosAvios/$(d.ultimoMovimientoId)).data;
      return d.keys().hasAll(['codigo', 'maquilaId', 'unidad', 'cantidad', 'ultimoMovimientoId', 'actualizadoEn'])
        && d.keys().hasOnly(['codigo', 'maquilaId', 'unidad', 'cantidad', 'ultimoMovimientoId', 'actualizadoEn', 'creadoEn'])
        && d.codigo == codigo
        && d.maquilaId == mid
        && d.cantidad is int
        && d.cantidad >= 0
        && d.actualizadoEn == request.time
        && d.ultimoMovimientoId is string
        // El movimiento NACIO en este request: uno viejo no se puede
        // re-aplicar para inflar el saldo.
        && m.creadoEn == request.time
        && m.maquilaId == mid
        && m.codigo == codigo
        && d.cantidad == m.saldoDespues;
    }

    match /portalMaquila/{maquilaId}/saldosAvios/{codigo} {
      allow read: if puedeVerAvios() || esMaquilaDe(maquilaId);
      allow create: if (puedeManejarAvios() || esAdmin() || esMaquilaDe(maquilaId))
        && mismoMundoMaquila(maquilaId)
        && saldoAtadoAlMovimiento(maquilaId, codigo)
        && request.resource.data.creadoEn == request.time
        && getAfter(/databases/$(database)/documents/portalMaquila/$(maquilaId)/movimientosAvios/$(request.resource.data.ultimoMovimientoId)).data.saldoAntes == 0;
      allow update: if (puedeManejarAvios() || esAdmin() || esMaquilaDe(maquilaId))
        && mismoMundoMaquila(maquilaId)
        && saldoAtadoAlMovimiento(maquilaId, codigo)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['cantidad', 'ultimoMovimientoId', 'actualizadoEn'])
        // El movimiento tiene que arrancar EXACTAMENTE del saldo que habia:
        // si dos personas mueven el mismo codigo a la vez, la segunda falla y
        // se reintenta, en vez de pisar el saldo.
        && getAfter(/databases/$(database)/documents/portalMaquila/$(maquilaId)/movimientosAvios/$(request.resource.data.ultimoMovimientoId)).data.saldoAntes == resource.data.cantidad;
      allow delete: if false;
    }

    // DISCREPANCIA: se abre sola cuando lo que la maquila declara no coincide
    // con lo que almacen mando. Es el aviso para Alvaro de que algo no cuadro.
    match /portalMaquila/{maquilaId}/discrepanciasAvios/{discId} {
      allow read: if puedeVerAvios() || esMaquilaDe(maquilaId);
      allow create: if esMaquilaDe(maquilaId)
        && request.resource.data.keys().hasAll(['maquilaId', 'envioId', 'codigo', 'descripcion', 'unidad', 'cantidadEnviada', 'cantidadRecibida', 'diferencia', 'estado', 'comentarioMaquila', 'abiertaEn'])
        && request.resource.data.keys().hasOnly(['maquilaId', 'envioId', 'codigo', 'descripcion', 'unidad', 'cantidadEnviada', 'cantidadRecibida', 'diferencia', 'estado', 'comentarioMaquila', 'abiertaEn', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn', 'resolucion'])
        && request.resource.data.maquilaId == maquilaId
        && discId == request.resource.data.envioId + '_' + request.resource.data.codigo
        && request.resource.data.cantidadEnviada is int
        && request.resource.data.cantidadRecibida is int
        && request.resource.data.diferencia == request.resource.data.cantidadRecibida - request.resource.data.cantidadEnviada
        && request.resource.data.diferencia != 0
        && request.resource.data.estado == 'abierta'
        && request.resource.data.comentarioMaquila is string
        && request.resource.data.comentarioMaquila.size() <= 300
        && request.resource.data.abiertaEn == request.time
        && !('resueltoPorUid' in request.resource.data)
        // Solo sobre un acuse que se esta creando en este mismo lote.
        && getAfter(/databases/$(database)/documents/portalMaquila/$(maquilaId)/acusesAvios/$(request.resource.data.envioId)).data.maquilaId == maquilaId;
      // Almacen la cierra dejando constancia de que se entero y que hizo.
      allow update: if puedeManejarAvios()
        && mismoMundoMaquila(maquilaId)
        && resource.data.estado == 'abierta'
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['estado', 'resueltoPorUid', 'resueltoPorNombre', 'resueltoEn', 'resolucion'])
        && request.resource.data.estado == 'revisada'
        && request.resource.data.resueltoPorUid == request.auth.uid
        && request.resource.data.resueltoPorNombre == perfil().get('nombreCompleto', '')
        && request.resource.data.resueltoEn == request.time
        && request.resource.data.resolucion is string
        && request.resource.data.resolucion.size() > 0
        && request.resource.data.resolucion.size() <= 300;
      allow delete: if false;
    }

    // ===================================================================
    // TAREAS DE ENSAMBLE PARA MAQUILAS (2026-08-13)
    // ===================================================================
    // Lindbergh encarga a una maquila que ensamble modelos, con el TECH PACK
    // del pedido adjunto. El tech pack tiene informacion sensible del cliente:
    // la maquila solo lo VE mientras la tarea esta abierta, y al terminar la
    // tarea el archivo se borra. El archivo vive TROCEADO en Firestore
    // (Storage no esta habilitado en el proyecto): techPackChunks/00..16 de
    // hasta 950 KB cada uno (tope 17), con manifiesto (tamano, totalChunks, sha256) en
    // la tarea para que el visor detecte cualquier corrupcion al rearmarlo.
    //
    // Estados: 'preparando' (subiendo el archivo; la maquila NO la ve todavia)
    // -> 'abierta' (la maquila la ve y puede leer el tech pack) -> 'iniciada'
    // y 'declarada' (lo que ella misma reporta; sigue leyendo el archivo) ->
    // 'terminada'
    // o 'cancelada' (la maquila ya NO puede leer los chunks aunque sigan
    // fisicamente un momento: el borrado corre en lotes despues del cierre,
    // porque borrar 40 chunks en el mismo batch reventaria los 10 MiB por
    // request).
    // ---- Estados que la tarea recorre estando VIVA ----
    // La maquila reporta su avance (2026-08-14): 'iniciada' cuando empieza a
    // armar y 'declarada' cuando dice que termino. La tarea NO se cierra con
    // eso: cerrarla es de Quini, y es el cierre lo que borra el tech pack.
    // Asi un dedazo de la maquila no le quita el documento que necesita.
    function estadosVivosTarea() {
      return ['preparando', 'abierta', 'iniciada', 'declarada'];
    }

    // El reporte de la maquila (sus tiempos y firmas, y el motivo con el que
    // Quini se la regreso) NO lo escribe Quini: solo se mueve por las ramas
    // que le corresponden a cada quien.
    //
    // Hace falta decirlo explicitamente porque la rama de reedicion de Quini
    // valida el documento COMPLETO en vez de acotar por diff: sin esto, desde
    // 'abierta' podria sembrar un 'iniciadaEn' con la fecha que quisiera y
    // firmarlo a nombre de la maquila -- y de esa fecha sale cuanto tardo en
    // armar, que es lo que despues va a pagar. Que nadie pueda fabricar el
    // numero que le conviene es justo el punto de medirlo.
    function reporteDeLaMaquilaIntacto() {
      let n = request.resource.data;
      let v = resource.data;
      return n.get('iniciadaEn', null) == v.get('iniciadaEn', null)
        && n.get('iniciadaPorUid', null) == v.get('iniciadaPorUid', null)
        && n.get('iniciadaPorNombre', null) == v.get('iniciadaPorNombre', null)
        && n.get('declaradaEn', null) == v.get('declaradaEn', null)
        && n.get('declaradaPorUid', null) == v.get('declaradaPorUid', null)
        && n.get('declaradaPorNombre', null) == v.get('declaradaPorNombre', null)
        && n.get('notaMaquila', null) == v.get('notaMaquila', null)
        && n.get('devueltaEn', null) == v.get('devueltaEn', null)
        && n.get('devueltaPorUid', null) == v.get('devueltaPorUid', null)
        && n.get('devueltaPorNombre', null) == v.get('devueltaPorNombre', null)
        && n.get('motivoDevolucion', null) == v.get('motivoDevolucion', null);
    }

    // ¿La terna quien/cuando de una firma esta COMPLETA o completamente
    // vacia? Nunca a medias: una firma con fecha y sin nombre (o al reves) es
    // un dato que no se puede auditar.
    function firmaCoherente(d, campoEn, campoUid, campoNombre) {
      return (d.get(campoEn, null) == null
              && d.get(campoUid, null) == null
              && d.get(campoNombre, null) == null)
        || (d.get(campoEn, null) is timestamp
            && d.get(campoUid, null) is string
            && d.get(campoNombre, null) is string
            && d.get(campoNombre, '').size() > 0);
    }

    function tareaEnsambleValida(mid) {
      let d = request.resource.data;
      // Los campos del reporte de la maquila van en hasOnly pero NO en hasAll,
      // y se leen con get(...,null): asi las tareas que ya estaban vivas antes
      // de este cambio siguen siendo validas sin migrarlas. Meterlos en hasAll
      // habria obligado a migrar todos los documentos ANTES de poder tocar
      // ninguno.
      return d.keys().hasAll(['maquilaId', 'titulo', 'renglones', 'notas', 'estado', 'techPack', 'publicadaEn', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'terminadaEn', 'terminadaPorUid', 'terminadaPorNombre', 'techPackBorradoEn'])
        && d.keys().hasOnly(['maquilaId', 'titulo', 'renglones', 'notas', 'estado', 'techPack', 'publicadaEn', 'creadoPorUid', 'creadoPorNombre', 'creadoEn', 'terminadaEn', 'terminadaPorUid', 'terminadaPorNombre', 'techPackBorradoEn', 'iniciadaEn', 'iniciadaPorUid', 'iniciadaPorNombre', 'declaradaEn', 'declaradaPorUid', 'declaradaPorNombre', 'notaMaquila', 'devueltaEn', 'devueltaPorUid', 'devueltaPorNombre', 'motivoDevolucion', 'ot', 'destino', 'fechaRequerida'])
        // El amarre con el plan maestro (2026-08-18): 'ot' es la orden de
        // trabajo que esta tarea trabaja y 'destino' a quien va ('Modular
        // Walmart Jun-Sep'). Opcionales y leidos con get(...,null): las tareas
        // de antes no los traen y siguen validas sin migrar nada. Es el puente
        // para que las remisiones descuenten tareas y para agrupar tareas por
        // OT en el arbol — la fase que la junta dejo para despues.
        // Las ramas de update de la maquila usan affectedKeys().hasOnly() con
        // listas que NO incluyen estos campos: la maquila no puede tocarlos.
        && (d.get('ot', null) == null
            || (d.get('ot', '') is string && d.get('ot', '').size() > 0 && d.get('ot', '').size() <= 40))
        && (d.get('destino', null) == null
            || (d.get('destino', '') is string
                && d.get('destino', '').size() > 0
                && d.get('destino', '').size() <= 120))
        // PARA CUANDO SE NECESITA (2026-09-02). Es lo que ordena el trabajo de
        // la maquila: lo de hoy arriba, lo de dentro de dos semanas abajo.
        // Va como TEXTO 'AAAA-MM-DD', no como timestamp, a proposito: asi se
        // ordena y se compara sin pasar por zonas horarias — una fecha 'sin
        // hora' convertida a Date se corre un dia en Mexico (regla dura 3).
        && (d.get('fechaRequerida', null) == null
            || (d.get('fechaRequerida', '') is string
                && d.get('fechaRequerida', '').matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$')))
        // Sin OT no hay destino que amarrar: el destino sale del plan VIA la
        // OT; suelto seria texto libre disfrazado de dato.
        && (d.get('destino', null) == null || d.get('ot', null) != null)
        // Las tres firmas del ciclo, cada una entera o vacia.
        && firmaCoherente(d, 'iniciadaEn', 'iniciadaPorUid', 'iniciadaPorNombre')
        && firmaCoherente(d, 'declaradaEn', 'declaradaPorUid', 'declaradaPorNombre')
        && firmaCoherente(d, 'devueltaEn', 'devueltaPorUid', 'devueltaPorNombre')
        && (d.get('notaMaquila', null) == null
            || (d.get('notaMaquila', '') is string && d.get('notaMaquila', '').size() <= 300))
        && (d.get('motivoDevolucion', null) == null
            || (d.get('motivoDevolucion', '') is string && d.get('motivoDevolucion', '').size() <= 300))
        // Coherencia estado <-> firmas. No se puede declarar sin haber
        // iniciado, ni estar 'iniciada'/'declarada' sin su firma: si no, los
        // tiempos que se midan despues son mentira.
        && (d.estado != 'iniciada' || d.get('iniciadaEn', null) != null)
        && (d.estado != 'declarada' || (d.get('iniciadaEn', null) != null && d.get('declaradaEn', null) != null))
        && (d.get('declaradaEn', null) == null || d.get('iniciadaEn', null) != null)
        // Mientras vive, nada de firma de cierre. (El cierre directo desde
        // 'abierta' o 'iniciada' sigue permitido: ahi las firmas de la maquila
        // simplemente se quedan en null y el reporte lo marca como incompleto.)
        && (!(d.estado in estadosVivosTarea())
            || (d.terminadaEn == null && d.terminadaPorUid == null && d.terminadaPorNombre == null))
        // El manifiesto solo se borra en una tarea ya cerrada.
        && (d.get('techPackBorradoEn', null) == null
            || (!(d.estado in estadosVivosTarea()) && d.techPack == null))
        // 'publicadaEn' se fija la PRIMERA vez que la tarea llega a 'abierta'
        // y ya no se quita: es lo que decide si la maquila la ve. Un borrador
        // que se preparo para la maquila equivocada y se cancelo sin publicar
        // NUNCA fue suyo, y no tiene por que aparecerle.
        && (d.publicadaEn == null || d.publicadaEn is timestamp)
        // Todo estado en que la maquila la ve exige publicadaEn.
        && (!(d.estado in ['abierta', 'iniciada', 'declarada']) || d.publicadaEn != null)
        && d.maquilaId == mid
        && d.titulo is string
        && d.titulo.size() > 0
        && d.titulo.size() <= 120
        && d.renglones is list
        && d.renglones.size() > 0
        && d.renglones.size() <= 60
        && d.notas is string
        && d.notas.size() <= 300
        && d.estado in ['preparando', 'abierta', 'iniciada', 'declarada', 'terminada', 'cancelada']
        && (d.techPack == null || (
              d.techPack.keys().hasAll(['nombre', 'formato', 'tamano', 'totalChunks', 'sha256', 'subidoEn'])
              && d.techPack.keys().hasOnly(['nombre', 'formato', 'tamano', 'totalChunks', 'sha256', 'subidoEn'])
              && d.techPack.nombre is string
              && d.techPack.nombre.size() > 0
              && d.techPack.nombre.size() <= 200
              && d.techPack.formato in ['pdf', 'xlsx']
              && d.techPack.tamano is int
              && d.techPack.tamano > 0
              // Tope 15 MB y coherencia con los chunks: ni un chunk de mas
              // ni un tamano que no quepa en los declarados.
              && d.techPack.tamano <= 15728640
              && d.techPack.totalChunks is int
              && d.techPack.totalChunks >= 1
              && d.techPack.totalChunks <= 17
              && d.techPack.tamano <= d.techPack.totalChunks * 950000
              && d.techPack.tamano > (d.techPack.totalChunks - 1) * 950000
              // Hexadecimal de verdad, no 64 caracteres cualesquiera: es lo
              // que el visor compara para detectar un archivo corrupto.
              && d.techPack.sha256 is string
              && d.techPack.sha256.matches('^[0-9a-f]{64}$')
              && d.techPack.subidoEn is timestamp
            ));
    }

    // PRECIOS DE ENSAMBLE por maquila y MODELO.
    //
    // Es lo que se le paga a cada maquila por armar un pack de ese codigo, y
    // es lo que va a imprimir su remision. Los pone Cielo.
    //
    // La MAQUILA lee los SUYOS —y solo los suyos, porque la ruta la aisla—:
    // los necesita para su remision y es lo que va a cobrar. No puede
    // escribirlos: el precio lo pone quien paga, no quien cobra.
    // ⚠️ El ID del documento es el MODELO, no el codigo de producto.
    // Cambiado el 2026-08-25: cada maquila cobra por MODELO, y un modelo
    // agrupa varias tallas y colores que se pagan IGUAL (Cielo lo confirmo por
    // correo el 24-08: "el precio si es el mismo para el modelo en diferentes
    // tallas"). Con la llave por codigo, RBFW26T412 pedia capturar seis veces
    // el mismo precio, y el sexto se iba a quedar sin poner.
    match /portalMaquila/{maquilaId}/preciosEnsamble/{modelo} {
      allow read: if esInterno() || esMaquilaDe(maquilaId);
      // mismoMundoMaquila y NO soloCuentaReal: una cuenta de prueba SI debe
      // poder ponerle precios a la maquila ficticia (es su corral), y una
      // cuenta real NO debe tocarla. soloCuentaReal bloqueaba la prueba
      // entera — se cazo probando con la cuenta de Cielo.
      allow create, update: if puedeEditarPrecios()
        && mismoMundoMaquila(maquilaId)
        && precioEnsambleValido()
        && request.resource.data.maquilaId == maquilaId
        && request.resource.data.modelo == modelo;
      // No se borran: un precio que existio explica una remision que ya se
      // pago. Para dejar de usarlo se pone el nuevo encima.
      allow delete: if false;
    }

    match /portalMaquila/{maquilaId}/tareasEnsamble/{tareaId} {
      // La maquila solo ve tareas que de verdad llegaron a estar ABIERTAS
      // alguna vez ('publicadaEn' fijado). Un borrador en 'preparando' -- o
      // uno que se preparo para la maquila equivocada y se cancelo antes de
      // publicarlo -- nunca fue suyo y no le aparece.
      // AMPLIADO el 2026-08-24, de puedeCrearTareas() a los roles que abren el
      // ARBOL DE ORDENES. Ese arbol estrena una columna "Ya en maquila" y con
      // el permiso anterior solo Lindbergh y direccion leian las tareas, asi
      // que a America (rol 'completo' SIN el flag) la columna le salia siempre
      // vacia: un permiso negado disfrazado de cero.
      //
      // ⚠️ NO se abrio a esInterno() a secas, por dos razones medidas:
      //
      // 1. CAPTURA y ALMACEN no abren esa pantalla (TABS_CAPTURA es solo
      //    'captura'; la pestaña 'tareas' del almacen pinta PanelTareas, que
      //    lee la coleccion 'tareas', no esta). Darles lectura seria regalar
      //    un dato que su app nunca les enseña -- el mismo error que este
      //    archivo ya documento y corrigio en puedeVerElEquipo().
      //
      // 2. El documento NO es inocuo: 'titulo' se pide literalmente como "el
      //    pedido o el cliente", y 'techPack.nombre' suele traer los dos.
      //    Ademas hay tres campos de texto libre (notas, notaMaquila,
      //    motivoDevolucion). Sin el candado del corral, las seis cuentas
      //    demo internas leerian el nombre del cliente de CUALQUIER maquila
      //    real, borradores en 'preparando' incluidos.
      //
      // El TECH PACK en si no viaja aqui: vive en techPackChunks, que sigue
      // exigiendo puedeCrearTareas() y no hereda nada de esta regla.
      allow read: if (esInterno()
          && rol() in ['admin', 'completo', 'consulta', 'produccion', 'pt']
          && mismoMundoMaquila(maquilaId))
        || (esMaquilaDe(maquilaId) && resource.data.get('publicadaEn', null) != null);
      // Una tarea de ensamble lleva el Tech Pack del pedido adentro: mandarle
      // una de prueba a una maquila real seria filtrarle el documento de un
      // cliente. Solo a la ficticia.
      allow create: if puedeCrearTareas()
        && mismoMundoMaquila(maquilaId)
        && tareaEnsambleValida(maquilaId)
        && request.resource.data.estado in ['preparando', 'abierta']
        // Una tarea que nace 'abierta' no puede declarar tech pack: los
        // chunks solo se escriben en 'preparando', asi que un manifiesto en
        // el create apuntaria a chunks que no existen.
        && (request.resource.data.estado == 'preparando' || request.resource.data.techPack == null)
        && (request.resource.data.publicadaEn == null
            || request.resource.data.publicadaEn == request.time)
        && request.resource.data.creadoPorUid == request.auth.uid
        && request.resource.data.creadoPorNombre == perfil().get('nombreCompleto', '')
        && request.resource.data.creadoEn == request.time
        && request.resource.data.terminadaEn == null
        && request.resource.data.terminadaPorUid == null
        && request.resource.data.terminadaPorNombre == null
        && request.resource.data.techPackBorradoEn == null;
      // ---- Lo que hace QUINI (Lindbergh o el admin) ----
      allow update: if puedeCrearTareas() && mismoMundoMaquila(maquilaId) && (
          // (1) Mientras nadie la ha empezado ('preparando' o 'abierta'): se
          // reedita entera, se publica ('preparando' -> 'abierta'), se regresa
          // a 'preparando' para cambiarle el archivo, o se cierra. Quien la
          // creo no cambia.
          ( resource.data.estado in ['preparando', 'abierta']
            && tareaEnsambleValida(maquilaId)
            // Esta rama reescribe el documento entero (es la de reedicion),
            // asi que lo que NO se puede tocar hay que blindarlo a mano.
            && reporteDeLaMaquilaIntacto()
            && request.resource.data.creadoPorUid == resource.data.creadoPorUid
            && request.resource.data.creadoPorNombre == resource.data.creadoPorNombre
            && request.resource.data.creadoEn == resource.data.creadoEn
            // 'publicadaEn' se fija UNA vez (al publicar) y ya no se borra:
            // si se pudiera quitar, una tarea ya entregada desapareceria del
            // portal de la maquila sin rastro.
            && ( request.resource.data.publicadaEn == resource.data.get('publicadaEn', null)
                 || (resource.data.get('publicadaEn', null) == null
                     && request.resource.data.publicadaEn == request.time) )
            // Al cerrar queda firmado quien y cuando; mientras vive, en null.
            && ( (request.resource.data.estado in ['preparando', 'abierta']
                   && request.resource.data.terminadaEn == null
                   && request.resource.data.terminadaPorUid == null
                   && request.resource.data.terminadaPorNombre == null)
                 || (request.resource.data.estado in ['terminada', 'cancelada']
                   && request.resource.data.terminadaEn == request.time
                   && request.resource.data.terminadaPorUid == request.auth.uid
                   && request.resource.data.terminadaPorNombre == perfil().get('nombreCompleto', '')) ) )
          ||
          // (2) La maquila YA la empezo o ya la declaro terminada: aqui Quini
          // solo CIERRA (o cancela). Se acota con un diff exacto a propósito:
          // reeditarle los renglones o el tech pack a alguien que ya esta
          // armando cambia el encargo debajo de sus manos, y reescribir el
          // documento entero le permitiria ademas pisar la firma de la maquila
          // (los tiempos que despues pagan la maquila).
          ( resource.data.estado in ['iniciada', 'declarada']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'terminadaEn', 'terminadaPorUid', 'terminadaPorNombre', 'techPack'])
            // El manifiesto se borra EN EL MISMO WRITE que cierra, no despues.
            // La maquila conserva lectura del documento mientras publicadaEn
            // exista, asi que dejarlo un momento mas le seguiria mostrando el
            // nombre del archivo -- y ese nombre suele traer el cliente y el
            // pedido. Los chunks se barren luego; 'techPackBorradoEn' se queda
            // en null hasta que ese barrido de verdad termine.
            && (request.resource.data.get('techPack', null) == null
                || request.resource.data.get('techPack', null) == resource.data.get('techPack', null))
            && request.resource.data.estado in ['terminada', 'cancelada']
            && request.resource.data.terminadaEn == request.time
            && request.resource.data.terminadaPorUid == request.auth.uid
            && request.resource.data.terminadaPorNombre == perfil().get('nombreCompleto', '') )
          ||
          // (3) DEVOLVER una tarea declarada: no cuadro lo que entrego, vuelve
          // a manos de la maquila. Queda firmado quien la devolvio y por que
          // -- sin eso, la maquila veria su tarea "abierta otra vez" sin
          // entender que paso, y no se distinguiria de que ella misma retirara
          // su declaracion.
          ( resource.data.estado == 'declarada'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'declaradaEn', 'declaradaPorUid', 'declaradaPorNombre',
                           'devueltaEn', 'devueltaPorUid', 'devueltaPorNombre', 'motivoDevolucion'])
            && request.resource.data.estado == 'iniciada'
            // La declaracion se limpia (la tarea ya no esta declarada), pero
            // el 'iniciadaEn' original NO se toca: el tiempo de armado tiene
            // que incluir el retrabajo, o devolver una tarea seria una forma
            // de mejorarle el numero a la maquila.
            && request.resource.data.declaradaEn == null
            && request.resource.data.declaradaPorUid == null
            && request.resource.data.declaradaPorNombre == null
            && request.resource.data.devueltaEn == request.time
            && request.resource.data.devueltaPorUid == request.auth.uid
            && request.resource.data.devueltaPorNombre == perfil().get('nombreCompleto', '')
            && request.resource.data.motivoDevolucion is string
            && request.resource.data.motivoDevolucion.size() > 0
            && request.resource.data.motivoDevolucion.size() <= 300 )
          ||
          // (4) Ya cerrada: SOLO la limpieza del tech pack (borrar el
          // manifiesto cuando los chunks ya se barrieron). Nada mas.
          ( resource.data.estado in ['terminada', 'cancelada']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['techPack', 'techPackBorradoEn'])
            && request.resource.data.techPack == null
            && request.resource.data.techPackBorradoEn == request.time )
        );

      // ---- Lo que hace la MAQUILA: reportar su avance ----
      // Tres transiciones, cada una con su diff exacto. La maquila NUNCA toca
      // el encargo (titulo, renglones, notas), ni el tech pack, ni las firmas
      // de Quini: dar 'allow update sobre su propio documento' sin acotar deja
      // reescribirlo entero (es la lección que dejaron las tareas internas,
      // donde la persona asignada podía bajarse la meta a 0.01).
      allow update: if esMaquilaDe(maquilaId)
        && resource.data.get('publicadaEn', null) != null
        && tareaEnsambleValida(maquilaId)
        && (
          // (a) EMPECE. Solo desde 'abierta', y una vez: 'iniciadaEn' nace
          // aqui y ya no se vuelve a mover en toda la vida de la tarea.
          ( resource.data.estado == 'abierta'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'iniciadaEn', 'iniciadaPorUid', 'iniciadaPorNombre'])
            && request.resource.data.estado == 'iniciada'
            && request.resource.data.iniciadaEn == request.time
            && request.resource.data.iniciadaPorUid == request.auth.uid
            && request.resource.data.iniciadaPorNombre == perfil().get('nombreCompleto', '') )
          ||
          // (b) YA TERMINE. Desde 'iniciada' -- y tambien desde 'abierta',
          // porque a quien se le olvido marcar el inicio no se le puede dejar
          // la tarea atorada; en ese caso el inicio se sella tambien ahora y
          // el tiempo de armado sale en cero, que es la verdad conocida.
          ( resource.data.estado in ['abierta', 'iniciada']
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'iniciadaEn', 'iniciadaPorUid', 'iniciadaPorNombre',
                           'declaradaEn', 'declaradaPorUid', 'declaradaPorNombre', 'notaMaquila',
                           'motivoDevolucion'])
            && request.resource.data.estado == 'declarada'
            // Al volver a declarar se SALDA la devolucion anterior: el motivo
            // deja de estar pendiente porque ya se respondio. Solo se puede
            // limpiar (nunca escribir otro), y el rastro de QUIEN la devolvio
            // y CUANDO se conserva -- eso no lo puede tocar la maquila.
            //
            // Es lo que evita que el aviso "te la regresaron" reaparezca mas
            // tarde, cuando la maquila retire una declaracion posterior: el
            // estado 'iniciada' se alcanza por dos caminos distintos y solo
            // uno de ellos es una devolucion de verdad.
            && request.resource.data.get('motivoDevolucion', null) == null
            // Si ya estaba iniciada, su firma de inicio se conserva intacta.
            && ( resource.data.estado == 'abierta'
                 || ( request.resource.data.iniciadaEn == resource.data.iniciadaEn
                      && request.resource.data.iniciadaPorUid == resource.data.iniciadaPorUid
                      && request.resource.data.iniciadaPorNombre == resource.data.iniciadaPorNombre ) )
            && ( resource.data.estado == 'iniciada'
                 || ( request.resource.data.iniciadaEn == request.time
                      && request.resource.data.iniciadaPorUid == request.auth.uid
                      && request.resource.data.iniciadaPorNombre == perfil().get('nombreCompleto', '') ) )
            && request.resource.data.declaradaEn == request.time
            && request.resource.data.declaradaPorUid == request.auth.uid
            && request.resource.data.declaradaPorNombre == perfil().get('nombreCompleto', '')
            && (request.resource.data.get('notaMaquila', null) == null
                || (request.resource.data.notaMaquila is string
                    && request.resource.data.notaMaquila.size() <= 300)) )
          ||
          // (c) ME EQUIVOQUE: retira su propia declaracion, mientras Quini no
          // la haya confirmado ni devuelto. El 'iniciadaEn' se conserva.
          ( resource.data.estado == 'declarada'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['estado', 'declaradaEn', 'declaradaPorUid', 'declaradaPorNombre', 'notaMaquila'])
            && request.resource.data.estado == 'iniciada'
            && request.resource.data.declaradaEn == null
            && request.resource.data.declaradaPorUid == null
            && request.resource.data.declaradaPorNombre == null )
        );
      allow delete: if false;
    }

    match /portalMaquila/{maquilaId}/tareasEnsamble/{tareaId}/techPackChunks/{chunkId} {
      // La maquila lee los chunks mientras la tarea esta VIVA EN SUS MANOS
      // ('abierta', 'iniciada' o 'declarada') y con manifiesto. En cuanto se
      // cierra, el primer write ya le corto la lectura, aunque el barrido
      // fisico tarde o falle a la mitad.
      //
      // ⚠️ Los tres estados, no solo 'abierta': el tech pack es EL DOCUMENTO
      // CON EL QUE ARMA, y dejarlo solo en 'abierta' significaria que al picar
      // "empece" lo pierde justo cuando lo necesita. 'declarada' tambien
      // cuenta, porque una tarea devuelta vuelve a sus manos.
      allow read: if puedeCrearTareas()
        || (esMaquilaDe(maquilaId)
            && get(/databases/$(database)/documents/portalMaquila/$(maquilaId)/tareasEnsamble/$(tareaId)).data.estado in ['abierta', 'iniciada', 'declarada']
            && get(/databases/$(database)/documents/portalMaquila/$(maquilaId)/tareasEnsamble/$(tareaId)).data.techPack != null);
      // Los chunks SOLO se escriben con la tarea en 'preparando': el archivo
      // no se puede cambiar debajo de una tarea que la maquila ya esta viendo.
      // El ID es de dos digitos 00..16 (tope 17 chunks = 15 MB): el espacio
      // de IDs queda acotado por regex, no por un campo que se pueda mentir.
      allow create, update: if puedeCrearTareas()
        && mismoMundoMaquila(maquilaId)
        && chunkId.matches('^(0[0-9]|1[0-6])$')
        && get(/databases/$(database)/documents/portalMaquila/$(maquilaId)/tareasEnsamble/$(tareaId)).data.estado == 'preparando'
        && request.resource.data.keys().hasAll(['maquilaId', 'datos'])
        && request.resource.data.keys().hasOnly(['maquilaId', 'datos'])
        && request.resource.data.maquilaId == maquilaId
        && request.resource.data.datos is bytes
        && request.resource.data.datos.size() > 0
        && request.resource.data.datos.size() <= 950000;
      // El barrido post-cierre y la limpieza de sobrantes al re-subir.
      //
      // Acotado por ESTADO: 'preparando' (se esta reemplazando el archivo) o
      // una tarea ya cerrada (el barrido de verdad). Antes se podia borrar en
      // cualquier estado: el cliente no lo hacia, pero nada impedia que un
      // interno le vaciara el tech pack a una maquila a media faena, dejandole
      // el documento con el que trabaja en "archivo corrupto". No es escalada
      // de privilegios, es dejar a alguien sin poder trabajar (2026-08-14).
      allow delete: if puedeCrearTareas()
        && mismoMundoMaquila(maquilaId)
        && get(/databases/$(database)/documents/portalMaquila/$(maquilaId)/tareasEnsamble/$(tareaId)).data.estado
             in ['preparando', 'terminada', 'cancelada'];
    }

    // Consultas de grupo para las vistas internas de avios. Solo lectura y
    // SOLO almacen/admin: America y Lindbergh ya no ven avios (recorte de
    // Roberto 2026-08-13) y las reglas lo dicen, no solo las pestanas.
    match /{rutaSaldos=**}/saldosAvios/{codigo} {
      allow read: if puedeVerAvios();
    }
    match /{rutaDisc=**}/discrepanciasAvios/{discId} {
      allow read: if puedeVerAvios();
    }
    match /{rutaMov=**}/movimientosAvios/{movId} {
      allow read: if puedeVerAvios();
    }

    // Alvaro ve los envios y acuses de TODAS las maquilas de una consulta.
    match /{rutaEnvios=**}/enviosAvios/{envioId} {
      allow read: if puedeVerAvios();
    }
    match /{rutaAcusesAvios=**}/acusesAvios/{envioId} {
      allow read: if puedeVerAvios();
    }

    // Alvaro necesita ver las solicitudes de TODAS las maquilas de una sola
    // consulta (collectionGroup). Las reglas escritas en la ruta concreta NO
    // autorizan consultas de grupo: hace falta este comodin recursivo. Se
    // acota a LECTURA de almacen/admin -- si dijera solo perfilActivo(), una
    // maquila podria leer las solicitudes de su competencia.
    match /{rutaPortal=**}/solicitudesAvios/{solicitudId} {
      allow read: if puedeVerAvios();
    }

    // El acuse de recibido. La maquila lo crea UNA sola vez y no se edita ni
    // se borra: es su declaracion firmada de lo que llego.
    match /portalMaquila/{maquilaId}/acuses/{registroId} {
      allow read: if puedeVerReportesMaquila() || esMaquilaDe(maquilaId);
      allow create: if esMaquilaDe(maquilaId)
        && request.resource.data.registroId == registroId
        // El exists va ANTES de acuseValido: esa funcion hace get() de la
        // salida y necesita que exista.
        && exists(/databases/$(database)/documents/portalMaquila/$(maquilaId)/salidas/$(registroId))
        // Una remision ANULADA (corregida y reemitida) no se acusa: hay que
        // acusar la que la sustituye.
        && get(/databases/$(database)/documents/portalMaquila/$(maquilaId)/salidas/$(registroId))
             .data.get('anuladaPorRegistroId', null) == null
        && acuseValido(maquilaId, registroId);
      allow update, delete: if false;
    }

    // Maquilas (destinos del PDF de salida). El ID del doc es el nombre
    // normalizado: los duplicados son imposibles por construccion. La
    // direccion es OBLIGATORIA (se precarga como Direccion Envio del PDF);
    // despues del alta solo se pueden cambiar 'activo' y 'direccion'.
    match /maquilas/{maquilaId} {
      allow read: if esInterno();
      // Dar de alta una maquila es dar de alta un destino real de embarque:
      // eso no se prueba desde la app. La ficticia la crea el script de altas
      // con la llave de servicio, que no pasa por aqui.
      allow create: if puedeEmbarcar()
        && soloCuentaReal()
        && request.resource.data.keys().hasAll(['nombre', 'direccion', 'activo', 'creadoEn', 'creadoPorUid'])
        && request.resource.data.keys().hasOnly(['nombre', 'direccion', 'activo', 'creadoEn', 'creadoPorUid'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 120
        && request.resource.data.direccion is string
        && request.resource.data.direccion.size() > 0
        && request.resource.data.direccion.size() <= 300
        && request.resource.data.activo == true
        && request.resource.data.creadoEn == request.time
        && request.resource.data.creadoPorUid == request.auth.uid;
      // Cambiar 'activo' o la direccion de una maquila REAL es operacion de
      // verdad (dar de baja a una maquila le cierra el portal en el acto), y
      // este documento no guarda quien lo toco: si una cuenta de prueba lo
      // hiciera, nadie podria rastrearlo. Solo la ficticia.
      allow update: if puedeEmbarcar()
        && mismoMundoMaquila(maquilaId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activo', 'direccion'])
        && request.resource.data.activo is bool
        && request.resource.data.direccion is string
        && request.resource.data.direccion.size() > 0
        && request.resource.data.direccion.size() <= 300;
      allow delete: if false;
    }
  }
}
