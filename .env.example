# ============================================
# Deportivos Quini - Sistema de Trazabilidad
# Copiar este archivo a .env y llenar los valores
# ============================================

# SQL Atalanta (solo lectura) - dejar vacio hasta tener credenciales
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
SQL_PASSWORD=
SQL_PORT=1433

# Bascula (bascula_bridge.py corre localmente en cada PC con bascula)
# COM_PORT=AUTO detecta solo el puerto correcto automaticamente (recomendado).
# Para fijarlo a mano usar COM_PORT=COM3 (o el numero que corresponda).
COM_PORT=AUTO
BAUD_RATE=9600
BASCULA_BRIDGE_PORT=8001

# Impresora Zebra ZM400
ZEBRA_IP=
ZEBRA_PORT=9100

# Base de datos propia (SQLite para MVP)
DATABASE_URL=sqlite:///./quini_trazabilidad.db

# App
APP_PORT=8000
# OBLIGATORIO: la app no arranca sin una clave unica. Generarla con:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Calibracion de peso
BULTOS_CALIBRACION=30

# Estacion de Validacion (puente mientras no hay acceso SQL al ERP)
VALIDACION_ACTIVA=true
MULTIPLICADOR_VALIDACION=12
TOLERANCIA_VALIDACION_PORCENTAJE=10
VALIDACION_MODO=observacion

# Peso maximo aceptado por captura, en gramos (proteccion contra lecturas
# erroneas de bascula)
PESO_MAX_GRAMOS=100000
